import HilbertFoundations.ConstructionsAux4

/-!
# Helper module for `Constructions.lean`: quadratic extensions and their embeddings into `ℂ`

This module contains no unit of Hilbert's text. For subfields of `ℝ`:

* `adjoinSq F b`: the field `F(b) = {r + s b}` when `b² ∈ F`, and `IsQuadExt F E b`: `E = F(b)`;
  `quadExt_closure`: the subfield generated by `F` and `b` is such an extension;
* `exists_ext`: an embedding `σ : F →+* ℂ` extends to `F(b)` (when `b ∉ F`) sending `b` to any
  square root `τ` of `σ(b²)`;
* `omega_ext`: every embedding of a subfield of `ℝ` into `ℂ` extends to a subfield containing a
  given number `x` of Hilbert's field `Ω`, mapping `x` to a real number of `Ω`;
* `omega_conj`: every algebraic number conjugate to a number of `Ω` is a real number of `Ω`;
* `not_mem_omega_example`: `√(2√2 - 2) ∉ Ω` (Hilbert's example of § 37).
-/

set_option linter.unusedSectionVars false

namespace HilbertFoundations

open Coord

/-! ## Quadratic extensions of subfields of `ℝ` -/

theorem two_mem_subfield (F : Subfield ℝ) : (2 : ℝ) ∈ F := by
  simp

/-- The field `F(b) = {r + s b : r, s ∈ F}`, for `b² ∈ F`. -/
def adjoinSq (F : Subfield ℝ) (b : ℝ) (hb : b ^ 2 ∈ F) : Subfield ℝ where
  carrier := {x | ∃ r ∈ F, ∃ s ∈ F, x = r + s * b}
  mul_mem' := by
    rintro _ _ ⟨r, hr, s, hs, rfl⟩ ⟨r', hr', s', hs', rfl⟩
    exact ⟨r * r' + s * s' * b ^ 2, F.add_mem (F.mul_mem hr hr') (F.mul_mem (F.mul_mem hs hs') hb),
      r * s' + s * r', F.add_mem (F.mul_mem hr hs') (F.mul_mem hs hr'), by ring⟩
  one_mem' := ⟨1, F.one_mem, 0, F.zero_mem, by ring⟩
  add_mem' := by
    rintro _ _ ⟨r, hr, s, hs, rfl⟩ ⟨r', hr', s', hs', rfl⟩
    exact ⟨r + r', F.add_mem hr hr', s + s', F.add_mem hs hs', by ring⟩
  zero_mem' := ⟨0, F.zero_mem, 0, F.zero_mem, by ring⟩
  neg_mem' := by
    rintro _ ⟨r, hr, s, hs, rfl⟩
    exact ⟨-r, F.neg_mem hr, -s, F.neg_mem hs, by ring⟩
  inv_mem' := by
    rintro _ ⟨r, hr, s, hs, rfl⟩
    by_cases h : r - s * b = 0
    · have e : r + s * b = 2 * r := by linarith
      rw [e]
      exact ⟨(2 * r)⁻¹, F.inv_mem (F.mul_mem (two_mem_subfield F) hr), 0, F.zero_mem, by ring⟩
    · by_cases h' : r + s * b = 0
      · rw [h', inv_zero]; exact ⟨0, F.zero_mem, 0, F.zero_mem, by ring⟩
      · have hNm : r ^ 2 - s ^ 2 * b ^ 2 ∈ F :=
          F.sub_mem (F.pow_mem hr 2) (F.mul_mem (F.pow_mem hs 2) hb)
        have hN : r ^ 2 - s ^ 2 * b ^ 2 ≠ 0 := by
          have : r ^ 2 - s ^ 2 * b ^ 2 = (r + s * b) * (r - s * b) := by ring
          rw [this]; exact mul_ne_zero h' h
        refine ⟨r / (r ^ 2 - s ^ 2 * b ^ 2), F.div_mem hr hNm,
          -s / (r ^ 2 - s ^ 2 * b ^ 2), F.div_mem (F.neg_mem hs) hNm, ?_⟩
        field_simp
        ring

/-- `E` is the quadratic extension `F(b)`: it contains `F` and `b`, `b² ∈ F`, and every element of
`E` is `r + s b` with `r, s ∈ F`. -/
structure IsQuadExt (F E : Subfield ℝ) (b : ℝ) : Prop where
  le : F ≤ E
  mem : b ∈ E
  sq_mem : b ^ 2 ∈ F
  repr : ∀ x ∈ E, ∃ r ∈ F, ∃ s ∈ F, x = r + s * b

/-- The subfield generated by `F` and `b` (with `b² ∈ F`) is `F(b)`. -/
theorem quadExt_closure {F : Subfield ℝ} {b : ℝ} (hb : b ^ 2 ∈ F) :
    IsQuadExt F (Subfield.closure ((F : Set ℝ) ∪ {b})) b where
  le x hx := Subfield.subset_closure (Or.inl hx)
  mem := Subfield.subset_closure (Or.inr rfl)
  sq_mem := hb
  repr x hx := by
    have hle : Subfield.closure ((F : Set ℝ) ∪ {b}) ≤ adjoinSq F b hb := by
      rw [Subfield.closure_le]
      rintro y (hy | rfl)
      · exact ⟨y, hy, 0, F.zero_mem, by ring⟩
      · exact ⟨0, F.zero_mem, 1, F.one_mem, by ring⟩
    exact hle hx

theorem repr_unique {F : Subfield ℝ} {b : ℝ} (hbF : b ∉ F) {r s r' s' : ℝ}
    (hr : r ∈ F) (hs : s ∈ F) (hr' : r' ∈ F) (hs' : s' ∈ F) (h : r + s * b = r' + s' * b) :
    r = r' ∧ s = s' := by
  by_cases hss : s = s'
  · subst hss; exact ⟨by linarith, rfl⟩
  · exfalso; apply hbF
    have : b = (r' - r) / (s - s') := by
      rw [eq_div_iff (sub_ne_zero.2 hss)]; linarith
    rw [this]; exact F.div_mem (F.sub_mem hr' hr) (F.sub_mem hs hs')

/-- If `b ∈ F`, then `F(b) = F`. -/
theorem IsQuadExt.eq_of_mem {F E : Subfield ℝ} {b : ℝ} (hE : IsQuadExt F E b) (hbF : b ∈ F) :
    E = F := by
  apply le_antisymm _ hE.le
  intro x hx
  obtain ⟨r, hr, s, hs, rfl⟩ := hE.repr x hx
  exact F.add_mem hr (F.mul_mem hs hbF)

section Ext

variable {F E : Subfield ℝ} {b : ℝ} (hE : IsQuadExt F E b) (hbF : b ∉ F) (σ : F →+* ℂ) (τ : ℂ)

/-- The value `σ(r) + σ(s) τ` at `x = r + s b` (the representation chosen). -/
noncomputable def extFun (x : E) : ℂ :=
  σ ⟨Classical.choose (hE.repr x x.2), (Classical.choose_spec (hE.repr x x.2)).1⟩ +
    σ ⟨Classical.choose (Classical.choose_spec (hE.repr x x.2)).2,
      (Classical.choose_spec (Classical.choose_spec (hE.repr x x.2)).2).1⟩ * τ

include hbF in
theorem extFun_eq (x : E) {r s : ℝ} (hr : r ∈ F) (hs : s ∈ F) (hx : (x : ℝ) = r + s * b) :
    extFun hE σ τ x = σ ⟨r, hr⟩ + σ ⟨s, hs⟩ * τ := by
  have h1 := Classical.choose_spec (hE.repr x x.2)
  have h2 := Classical.choose_spec h1.2
  have := repr_unique hbF h1.1 h2.1 hr hs (h2.2.symm.trans hx)
  unfold extFun
  have e1 : (⟨Classical.choose (hE.repr x x.2), h1.1⟩ : F) = ⟨r, hr⟩ := Subtype.ext this.1
  have e2 : (⟨Classical.choose h1.2, h2.1⟩ : F) = ⟨s, hs⟩ := Subtype.ext this.2
  rw [e1, e2]

include hbF in
/-- **Extension of an embedding** `σ : F →+* ℂ` to `F(b)` (`b ∉ F`), sending `b` to a square root
`τ` of `σ(b²)`. -/
theorem exists_ext (hτ : τ ^ 2 = σ ⟨b ^ 2, hE.sq_mem⟩) :
    ∃ σ' : E →+* ℂ, (∀ x : F, σ' ⟨x, hE.le x.2⟩ = σ x) ∧ σ' ⟨b, hE.mem⟩ = τ := by
  have hsq := hE.sq_mem
  let f : E →+* ℂ :=
    { toFun := extFun hE σ τ
      map_one' := by
        rw [extFun_eq hE hbF σ τ 1 F.one_mem F.zero_mem (by simp)]
        have h0 : (⟨0, F.zero_mem⟩ : F) = 0 := rfl
        have h1 : (⟨1, F.one_mem⟩ : F) = 1 := rfl
        rw [h0, h1, map_zero, map_one]; ring
      map_mul' := by
        intro x y
        obtain ⟨r, hr, s, hs, hx⟩ := hE.repr x x.2
        obtain ⟨r', hr', s', hs', hy⟩ := hE.repr y y.2
        have hm1 : r * r' + s * s' * b ^ 2 ∈ F :=
          F.add_mem (F.mul_mem hr hr') (F.mul_mem (F.mul_mem hs hs') hsq)
        have hm2 : r * s' + s * r' ∈ F := F.add_mem (F.mul_mem hr hs') (F.mul_mem hs hr')
        rw [extFun_eq hE hbF σ τ (x * y) hm1 hm2 (by push_cast; rw [hx, hy]; ring),
          extFun_eq hE hbF σ τ x hr hs hx, extFun_eq hE hbF σ τ y hr' hs' hy]
        have e1 : (⟨r * r' + s * s' * b ^ 2, hm1⟩ : F) =
            ⟨r, hr⟩ * ⟨r', hr'⟩ + ⟨s, hs⟩ * ⟨s', hs'⟩ * ⟨b ^ 2, hsq⟩ := rfl
        have e2 : (⟨r * s' + s * r', hm2⟩ : F) = ⟨r, hr⟩ * ⟨s', hs'⟩ + ⟨s, hs⟩ * ⟨r', hr'⟩ := rfl
        rw [e1, e2]
        simp only [map_add, map_mul]
        rw [← hτ]; ring
      map_zero' := by
        rw [extFun_eq hE hbF σ τ 0 F.zero_mem F.zero_mem (by simp)]
        have h0 : (⟨0, F.zero_mem⟩ : F) = 0 := rfl
        rw [h0, map_zero]; ring
      map_add' := by
        intro x y
        obtain ⟨r, hr, s, hs, hx⟩ := hE.repr x x.2
        obtain ⟨r', hr', s', hs', hy⟩ := hE.repr y y.2
        rw [extFun_eq hE hbF σ τ (x + y) (F.add_mem hr hr') (F.add_mem hs hs')
          (by push_cast; rw [hx, hy]; ring),
          extFun_eq hE hbF σ τ x hr hs hx, extFun_eq hE hbF σ τ y hr' hs' hy]
        have e1 : (⟨r + r', F.add_mem hr hr'⟩ : F) = ⟨r, hr⟩ + ⟨r', hr'⟩ := rfl
        have e2 : (⟨s + s', F.add_mem hs hs'⟩ : F) = ⟨s, hs⟩ + ⟨s', hs'⟩ := rfl
        rw [e1, e2, map_add, map_add]; ring }
  refine ⟨f, fun x => ?_, ?_⟩
  · show extFun hE σ τ _ = _
    rw [extFun_eq hE hbF σ τ _ x.2 F.zero_mem (by simp)]
    have h0 : (⟨0, F.zero_mem⟩ : F) = 0 := rfl
    rw [h0, map_zero, zero_mul, add_zero]
  · show extFun hE σ τ _ = _
    rw [extFun_eq hE hbF σ τ _ F.zero_mem F.one_mem (by simp)]
    have h0 : (⟨0, F.zero_mem⟩ : F) = 0 := rfl
    have h1 : (⟨1, F.one_mem⟩ : F) = 1 := rfl
    rw [h0, h1, map_zero, map_one, one_mul, zero_add]

end Ext

/-- A complex number whose square is a positive real number is real. -/
theorem real_of_sq_eq {z : ℂ} {t : ℝ} (ht : 0 ≤ t) (h : z ^ 2 = (t : ℂ)) :
    z = (Real.sqrt t : ℂ) ∨ z = -(Real.sqrt t : ℂ) := by
  have : z ^ 2 = (Real.sqrt t : ℂ) ^ 2 := by
    rw [h, ← Complex.ofReal_pow, Real.sq_sqrt ht]
  exact sq_eq_sq_iff_eq_or_eq_neg.1 this

/-! ## The numbers of `Ω` under embeddings -/

/-- **Every embedding extends to a number of `Ω`, mapping it into `Ω`**: for a subfield `F` of
`ℝ`, an embedding `σ : F →+* ℂ` and `x ∈ Ω`, there are a subfield `F' ⊇ F` containing `x` and an
extension `σ'` of `σ` to `F'` with `σ'(x)` a real number of `Ω`. -/
theorem omega_ext {x : ℝ} (hx : IsOmega x) :
    ∀ (F : Subfield ℝ) (σ : F →+* ℂ), ∃ (F' : Subfield ℝ) (hle : F ≤ F') (hxF : x ∈ F')
      (σ' : F' →+* ℂ), (∀ y : F, σ' ⟨y, hle y.2⟩ = σ y) ∧ ∃ r ∈ Omega, σ' ⟨x, hxF⟩ = (r : ℂ) := by
  induction hx with
  | one =>
    intro F σ
    refine ⟨F, le_rfl, F.one_mem, σ, fun y => rfl, 1, Omega.one_mem, ?_⟩
    have h1 : (⟨1, F.one_mem⟩ : F) = 1 := rfl
    rw [h1, map_one]; simp
  | @add a b _ _ iha ihb =>
    intro F σ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hra, hσa⟩ := iha F σ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hrb, hσb⟩ := ihb F1 σ1
    refine ⟨F2, h1.trans h2, F2.add_mem (h2 ha1) hb2, σ2, fun y => ?_, ra + rb,
      Omega.add_mem hra hrb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a + b, F2.add_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ + ⟨b, hb2⟩ := rfl
      rw [this, map_add, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @sub a b _ _ iha ihb =>
    intro F σ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hra, hσa⟩ := iha F σ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hrb, hσb⟩ := ihb F1 σ1
    refine ⟨F2, h1.trans h2, F2.sub_mem (h2 ha1) hb2, σ2, fun y => ?_, ra - rb,
      Omega.sub_mem hra hrb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a - b, F2.sub_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ - ⟨b, hb2⟩ := rfl
      rw [this, map_sub, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @mul a b _ _ iha ihb =>
    intro F σ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hra, hσa⟩ := iha F σ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hrb, hσb⟩ := ihb F1 σ1
    refine ⟨F2, h1.trans h2, F2.mul_mem (h2 ha1) hb2, σ2, fun y => ?_, ra * rb,
      Omega.mul_mem hra hrb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a * b, F2.mul_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ * ⟨b, hb2⟩ := rfl
      rw [this, map_mul, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @div a b _ _ _ iha ihb =>
    intro F σ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hra, hσa⟩ := iha F σ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hrb, hσb⟩ := ihb F1 σ1
    refine ⟨F2, h1.trans h2, F2.div_mem (h2 ha1) hb2, σ2, fun y => ?_, ra / rb,
      Omega.div_mem hra hrb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a / b, F2.div_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ / ⟨b, hb2⟩ := rfl
      rw [this, map_div₀, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @sqrt w _ ihw =>
    intro F σ
    obtain ⟨F1, h1, hw1, σ1, e1, rw', hrw, hσw⟩ := ihw F σ
    set y := Real.sqrt (1 + w ^ 2) with hy
    have hy2 : y ^ 2 = 1 + w ^ 2 := Real.sq_sqrt (by positivity)
    have hy2F : y ^ 2 ∈ F1 := by rw [hy2]; exact F1.add_mem F1.one_mem (F1.pow_mem hw1 2)
    have hσy2 : σ1 ⟨y ^ 2, hy2F⟩ = ((1 + rw' ^ 2 : ℝ) : ℂ) := by
      have : (⟨y ^ 2, hy2F⟩ : F1) = 1 + ⟨w, hw1⟩ ^ 2 := Subtype.ext (by simp [hy2])
      rw [this, map_add, map_one, map_pow, hσw]; push_cast; ring
    have hpos : (0 : ℝ) ≤ 1 + rw' ^ 2 := by positivity
    have hΩ : Real.sqrt (1 + rw' ^ 2) ∈ Omega := Omega.sqrt_mem hrw
    by_cases hyF : y ∈ F1
    · refine ⟨F1, h1, hyF, σ1, e1, ?_⟩
      have hsq : σ1 ⟨y, hyF⟩ ^ 2 = ((1 + rw' ^ 2 : ℝ) : ℂ) := by
        rw [← hσy2, ← map_pow]; rfl
      rcases real_of_sq_eq hpos hsq with h | h
      · exact ⟨_, hΩ, h⟩
      · exact ⟨_, Omega.neg_mem hΩ, by rw [h]; push_cast; ring⟩
    · have hE := quadExt_closure hy2F
      obtain ⟨σ2, e2, hσ2⟩ := exists_ext hE hyF σ1 (Real.sqrt (1 + rw' ^ 2) : ℂ) (by
        rw [hσy2, ← Complex.ofReal_pow, Real.sq_sqrt hpos])
      refine ⟨_, h1.trans hE.le, hE.mem, σ2, fun z => ?_, _, hΩ, hσ2⟩
      rw [← e1 z]; exact e2 ⟨z, h1 z.2⟩

end HilbertFoundations
