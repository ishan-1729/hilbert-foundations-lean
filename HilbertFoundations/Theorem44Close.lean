import HilbertFoundations.ConstructionsClose
import HilbertFoundations.Theorem44CloseAux2
import Hilbert17.FiniteVariableTransfer
import Hilbert17.OrderingSeparation
import TauCeti.FieldTheory.RealClosure.Basic

/-!
# Theorem 44 (§ 39)

This file closes the unit **`th.44`** of `Constructions.lean`: `theorem44 : Theorem44`, for any
number of parameters. By Hilbert's reduction (`theorem44_of_theorem43For`, `ConstructionsAux10`)
it is enough to prove the generalization of Theorem 43 to every domain `R = ℚ(S)` generated by
finitely many real numbers, `theorem43For_closure`: a number of `R` that is nonnegative under
every embedding of `R` into `ℝ` is a sum of squares of numbers of `R`. This is Artin's solution of
Hilbert's seventeenth problem (1927) for the finitely generated subfields of `ℝ`.

## What is taken from other libraries

* From the library `Hilbert17` (a copy of files of another project, see `Hilbert17/README.md`):
  in a semireal field an element that is not a sum of squares is negative in some ordering of the
  field (`Hilbert17.RingPreordering.isSumSq_iff_nonneg_all_orders`), and the transfer of a finite
  system of sign conditions on polynomials between two real closed fields
  (`Hilbert17Transfer.exists_matching_signs_eval₂`).
* From the Tau Ceti library, a dependency of this package: the real closure of an ordered field
  (`TauCeti.RealClosure.exists_realClosure`), and what `Hilbert17` takes from it.

## What this file and its two helper modules contribute

The passage from an ordering of the finitely generated field `R` to an embedding of `R` into `ℝ`
(the Artin–Lang step). Let `g ∈ R` not be a sum of squares; it is negative in an ordering of `R`;
in a real closure `L` of that ordered field `-g = w²`. The subfield `K` of `L` generated by `S`
and `w` is finitely generated. Choose a transcendence basis `t` of `K` among the generators and a
primitive element `α` of `K` over `ℚ(t)`; let `M ∈ ℚ[T][Y]` be the minimal polynomial of `α` with
the denominators cleared (`Theorem44CloseAux1`). The point `(t, α)` of `L` is a simple zero of
`M`; by the transfer there is a simple real zero `(τ₀, β₀)`; for every `τ` near `τ₀` the
polynomial `M(τ; ·)` has a real root `β`, and `τ` may be chosen with algebraically independent
coordinates (`Theorem44CloseAux2`). Then `t ↦ τ`, `α ↦ β` defines an embedding of `K` into `ℝ`,
under which `g = -w²` is negative.
-/

namespace HilbertFoundations

open Polynomial

noncomputable section

/-- The embedding of `ℚ` into an ordered field preserves signs. -/
theorem sign_algebraMap_rat {L : Type*} [Field L] [LinearOrder L] [IsStrictOrderedRing L]
    (a : ℚ) : SignType.sign (algebraMap ℚ L a) = SignType.sign a := by
  have hmono : StrictMono (algebraMap ℚ L) := by
    intro x y h
    rw [eq_ratCast, eq_ratCast]
    exact Rat.cast_lt.2 h
  exact hmono.sign_comp a

/-- **A finitely generated field with a homomorphism into a real closed field has a
homomorphism into `ℝ`.** -/
theorem nonempty_ringHom_real {K : Type*} [Field K] [CharZero K] {s : Set K} (hs : s.Finite)
    (hgen : Subfield.closure s = ⊤)
    {L : Type*} [Field L] [LinearOrder L] [IsStrictOrderedRing L] [IsRealClosed L]
    (j : K →+* L) : Nonempty (K →+* ℝ) := by
  obtain ⟨d, t, ht, hfin⟩ := exists_transcendence_data hs hgen
  obtain ⟨α, M, h0, h1, hreal⟩ := exists_poly_of_finite ht
  have hL0 : evalAt (j ∘ t) (j α) M = 0 := by rw [← map_evalAt, h0, map_zero]
  have hL1 : evalAt (j ∘ t) (j α) (derivative M) ≠ 0 := by
    rw [← map_evalAt]; exact (map_ne_zero j).2 h1
  obtain ⟨y, hy⟩ := Hilbert17Transfer.exists_matching_signs_eval₂ (algebraMap ℚ L) (algebraMap ℚ ℝ)
    (fun a => (sign_algebraMap_rat a).trans (sign_algebraMap_rat a).symm) (d + 1) 2
    ![(MvPolynomial.finSuccEquiv ℚ d).symm M,
      (MvPolynomial.finSuccEquiv ℚ d).symm (derivative M)]
    (Fin.cons (j α) (j ∘ t))
  have e0 := hy 0
  have e1 := hy 1
  rw [← Fin.cons_self_tail y] at e0 e1
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, ← evalAt_eq_eval₂] at e0 e1
  rw [hL0, sign_zero, sign_eq_zero_iff] at e0
  have e1' : evalAt (Fin.tail y) (y 0) (derivative M) ≠ 0 := by
    intro h
    rw [h, sign_zero] at e1
    exact hL1 (sign_eq_zero_iff.1 e1.symm)
  obtain ⟨δ, hδ, hroot⟩ := exists_root_near M (Fin.tail y) (y 0) e0 e1'
  obtain ⟨τ, hτ, hind⟩ := exists_algebraicIndependent_near d (Fin.tail y) δ hδ
  obtain ⟨β, hβ⟩ := hroot τ hτ
  exact hreal τ β hind hβ

/-- **In a finitely generated semireal field, an element that is not a sum of squares is
negative under some homomorphism into `ℝ`** (Artin). -/
theorem exists_ringHom_real_neg {K : Type} [Field K] [IsSemireal K] {s : Set K} (hs : s.Finite)
    (hgen : Subfield.closure s = ⊤) {a : K} (ha : ¬ IsSumSq a) :
    ∃ ψ : K →+* ℝ, ψ a < 0 := by
  classical
  obtain ⟨o, hneg⟩ :=
    not_forall.1 (mt (Hilbert17.RingPreordering.isSumSq_iff_nonneg_all_orders a).2 ha)
  obtain ⟨ho, hneg⟩ := Classical.not_imp.1 hneg
  let : LinearOrder K := o
  have : IsStrictOrderedRing K := ho
  obtain ⟨L, fieldL, orderL, orderedL, realClosedL, j, hj, -⟩ :=
    TauCeti.RealClosure.exists_realClosure K
  let : Field L := fieldL
  let : LinearOrder L := orderL
  have : IsStrictOrderedRing L := orderedL
  have : IsRealClosed L := realClosedL
  have ha0 : a < 0 := lt_of_not_ge hneg
  have hja : j a < 0 := by rw [← map_zero j]; exact hj ha0
  obtain ⟨w, hw⟩ := IsRealClosed.nonneg_iff_isSquare.1 (neg_nonneg.2 hja.le)
  have hw0 : w ≠ 0 := by
    rintro rfl
    rw [mul_zero, neg_eq_zero] at hw
    exact hja.ne hw
  -- the field generated by `j '' s` and `w`
  set T : Set L := j '' s ∪ {w} with hT
  have hTfin : T.Finite := (hs.image j).union (Set.finite_singleton w)
  have hjT : ∀ x : K, j x ∈ Subfield.closure T := by
    intro x
    have hx : x ∈ Subfield.closure s := hgen ▸ Subfield.mem_top x
    have hle : Subfield.closure s ≤ (Subfield.closure T).comap j :=
      Subfield.closure_le.2 fun z hz => Subfield.subset_closure (Or.inl ⟨z, hz, rfl⟩)
    exact hle hx
  have hwT : w ∈ Subfield.closure T := Subfield.subset_closure (Or.inr rfl)
  obtain ⟨φ⟩ := nonempty_ringHom_real
    (hTfin.preimage Subtype.coe_injective.injOn) (subfield_closure_coe_preimage T)
    (Subfield.closure T).subtype
  refine ⟨φ.comp (j.codRestrict (Subfield.closure T) hjT), ?_⟩
  have hφw : φ ⟨w, hwT⟩ ≠ 0 := (map_ne_zero φ).2 fun h => hw0 (congrArg Subtype.val h)
  have key : (j.codRestrict (Subfield.closure T) hjT) a = -(⟨w, hwT⟩ * ⟨w, hwT⟩) := by
    apply Subtype.ext
    show j a = -(w * w)
    rw [← hw, neg_neg]
  rw [RingHom.comp_apply, key, map_neg, map_mul]
  have := mul_self_pos.2 hφw
  linarith

/-- A sum of squares in the field `R` is a sum of squares of numbers of `R`. -/
theorem sosIn_of_isSumSq_subfield {R : Subfield ℝ} {x : R} (h : IsSumSq x) :
    SOSIn R (x : ℝ) := by
  induction h with
  | zero => simpa using (SOSIn.zero : SOSIn R 0)
  | @sq_add a s _ ih =>
    have e : ((a * a + s : R) : ℝ) = (a : ℝ) ^ 2 + (s : ℝ) := by push_cast; ring
    rw [e]; exact .cons a.2 ih

/-- **The generalization of Theorem 43 to every domain generated by finitely many real
numbers** (Artin 1927, with rational coefficients): a number of `R = ℚ(S)` that is
nonnegative under every embedding of `R` into `ℝ` is a sum of squares of numbers of `R`. -/
theorem theorem43For_closure (S : Finset ℝ) : Theorem43For (Subfield.closure (S : Set ℝ)) := by
  rintro g ⟨hg, hσ⟩
  by_cases hss : IsSumSq (⟨g, hg⟩ : Subfield.closure (S : Set ℝ))
  · exact ⟨g, 1, sosIn_of_isSumSq_subfield hss, sosIn_one _, one_ne_zero, by simp⟩
  · exfalso
    obtain ⟨ψ, hψ⟩ := exists_ringHom_real_neg
      (S.finite_toSet.preimage Subtype.coe_injective.injOn)
      (subfield_closure_coe_preimage (S : Set ℝ)) hss
    obtain ⟨r, hr, e⟩ := hσ (Complex.ofRealHom.comp ψ) fun y _ => ⟨ψ y, rfl⟩
    have e' : ((ψ ⟨g, hg⟩ : ℝ) : ℂ) = (r : ℂ) := e
    have : ψ ⟨g, hg⟩ = r := Complex.ofReal_injective e'
    linarith

/-- **Theorem 44** (unit `th.44`). -/
theorem theorem44 : Theorem44 := theorem44_of_theorem43For theorem43For_closure

end

end HilbertFoundations
