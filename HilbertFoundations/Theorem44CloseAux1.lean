import Mathlib
import Hilbert17.FinSuccEvaluation

/-!
# Helper module for `Theorem44Close.lean`: the polynomial of a finitely generated field

This module contains no unit of Hilbert's text. For a field `K` of characteristic `0` generated
by finitely many elements:

* `evalAt s y M`: the value `M(s; y)` of a polynomial `M ∈ ℚ[T₁, …, T_d][Y]` at a point of a
  commutative `ℚ`-algebra (`map_evalAt`, `evalAt_eq_eval₂`);
* `exists_transcendence_data`: `K` is finite over `ℚ(t)` for an algebraically independent family
  `t` chosen among the generators;
* `exists_poly_of_finite`: a primitive element `α` of `K` over `ℚ(t)` and its minimal polynomial
  with the denominators cleared, `M ∈ ℚ[T][Y]`: `(t, α)` is a simple zero of `M`, and every real
  zero `(τ, β)` of `M` with `τ` algebraically independent gives a homomorphism `K → ℝ`;
* `subfield_closure_coe_preimage`: a subfield generated by a set is generated by it as a field.
-/

set_option linter.unusedSectionVars false

namespace HilbertFoundations

open Polynomial

noncomputable section

variable {d : ℕ}

/-- The value `M(s; y)` of `M ∈ ℚ[T₁, …, T_d][Y]` at the point `(s, y)` of a commutative
`ℚ`-algebra: the coefficients are evaluated at `T = s`, then the polynomial at `Y = y`. -/
def evalAt {B : Type*} [CommRing B] [Algebra ℚ B] (s : Fin d → B) (y : B)
    (M : (MvPolynomial (Fin d) ℚ)[X]) : B :=
  (M.map (MvPolynomial.eval₂Hom (algebraMap ℚ B) s)).eval y

/-- `M(s; y)` is the value at `(y, s₁, …, s_d)` of the polynomial in `d + 1` variables that
corresponds to `M` (the variable `0` is `Y`). -/
theorem evalAt_eq_eval₂ {B : Type*} [CommRing B] [Algebra ℚ B] (s : Fin d → B) (y : B)
    (M : (MvPolynomial (Fin d) ℚ)[X]) :
    evalAt s y M = MvPolynomial.eval₂ (algebraMap ℚ B) (Fin.cons y s)
      ((MvPolynomial.finSuccEquiv ℚ d).symm M) := by
  have h := Hilbert17Transfer.eval₂_finSuccEquiv (algebraMap ℚ B) s y
    ((MvPolynomial.finSuccEquiv ℚ d).symm M)
  rwa [AlgEquiv.apply_symm_apply] at h

/-- A ring homomorphism commutes with the evaluation `M(s; y)`. -/
theorem map_evalAt {B C : Type*} [CommRing B] [Algebra ℚ B] [CommRing C] [Algebra ℚ C]
    (φ : B →+* C) (s : Fin d → B) (y : B) (M : (MvPolynomial (Fin d) ℚ)[X]) :
    φ (evalAt s y M) = evalAt (φ ∘ s) (φ y) M := by
  unfold evalAt
  rw [Polynomial.eval_map, Polynomial.eval_map, Polynomial.hom_eval₂]
  congr 1
  apply MvPolynomial.ringHom_ext
  · intro q; simp
  · intro i; simp

/-- If the image of `M` under `κ` is `κ b · ν` and `θ ∘ κ` is the evaluation at `s`, then
`M(s; y) = b(s) · (θ ν)(y)`. -/
theorem evalAt_of_map_eq {B : Type*} [CommRing B] [Algebra ℚ B] {Fr : Type*} [CommRing Fr]
    (κ : MvPolynomial (Fin d) ℚ →+* Fr) (M : (MvPolynomial (Fin d) ℚ)[X])
    (b : MvPolynomial (Fin d) ℚ) (ν : Fr[X]) (hM : M.map κ = C (κ b) * ν) (s : Fin d → B)
    (θ : Fr →+* B) (hθ : ∀ a, θ (κ a) = MvPolynomial.eval₂Hom (algebraMap ℚ B) s a) (y : B) :
    evalAt s y M = MvPolynomial.eval₂Hom (algebraMap ℚ B) s b * (ν.map θ).eval y := by
  unfold evalAt
  have h1 : MvPolynomial.eval₂Hom (algebraMap ℚ B) s = θ.comp κ :=
    RingHom.ext fun a => (hθ a).symm
  rw [h1, ← Polynomial.map_map, hM, Polynomial.map_mul, Polynomial.map_C, Polynomial.eval_mul,
    Polynomial.eval_C]
  rfl

/-- The hypothesis of `evalAt_of_map_eq` passes to the derivatives. -/
theorem derivative_map_eq {Fr : Type*} [CommRing Fr]
    (κ : MvPolynomial (Fin d) ℚ →+* Fr) (M : (MvPolynomial (Fin d) ℚ)[X])
    (b : MvPolynomial (Fin d) ℚ) (ν : Fr[X]) (hM : M.map κ = C (κ b) * ν) :
    (derivative M).map κ = C (κ b) * derivative ν := by
  rw [← Polynomial.derivative_map, hM, Polynomial.derivative_C_mul]

open scoped IntermediateField.algebraAdjoinAdjoin in
/-- **The polynomial of a finitely generated field.** If `K` is finite over `ℚ(t)`, `t`
algebraically independent, there are a primitive element `α` and a polynomial
`M ∈ ℚ[T₁, …, T_d][Y]` (the minimal polynomial of `α` over `ℚ(t)` with the denominators
cleared) such that `(t, α)` is a simple zero of `M` and every real zero `(τ, β)` of `M` with
`τ` algebraically independent gives a homomorphism `K → ℝ` (`t ↦ τ`, `α ↦ β`). -/
theorem exists_poly_of_finite {K : Type*} [Field K] [CharZero K] {t : Fin d → K}
    (ht : AlgebraicIndependent ℚ t)
    [FiniteDimensional (IntermediateField.adjoin ℚ (Set.range t)) K] :
    ∃ (α : K) (M : (MvPolynomial (Fin d) ℚ)[X]), evalAt t α M = 0 ∧
      evalAt t α (derivative M) ≠ 0 ∧
      ∀ (τ : Fin d → ℝ) (β : ℝ), AlgebraicIndependent ℚ τ → evalAt τ β M = 0 →
        Nonempty (K →+* ℝ) := by
  classical
  obtain ⟨α, hα⟩ := Field.exists_primitive_element (IntermediateField.adjoin ℚ (Set.range t)) K
  have hint : IsIntegral (IntermediateField.adjoin ℚ (Set.range t)) α := IsIntegral.of_finite _ α
  have hsep : (minpoly (IntermediateField.adjoin ℚ (Set.range t)) α).Separable :=
    (minpoly.irreducible hint).separable
  obtain ⟨c, hc, hN⟩ := IsLocalization.integerNormalization_spec
    (nonZeroDivisors (Algebra.adjoin ℚ (Set.range t)))
    (minpoly (IntermediateField.adjoin ℚ (Set.range t)) α)
  have hc0 : c ≠ 0 := nonZeroDivisors.ne_zero hc
  set κ : MvPolynomial (Fin d) ℚ →+* IntermediateField.adjoin ℚ (Set.range t) :=
    (algebraMap (Algebra.adjoin ℚ (Set.range t))
      (IntermediateField.adjoin ℚ (Set.range t))).comp
      (ht.aevalEquiv : MvPolynomial (Fin d) ℚ →+* Algebra.adjoin ℚ (Set.range t)) with hκ
  set σ : Algebra.adjoin ℚ (Set.range t) →+* MvPolynomial (Fin d) ℚ :=
    (ht.aevalEquiv.symm : Algebra.adjoin ℚ (Set.range t) →+* MvPolynomial (Fin d) ℚ) with hσ
  have hκσ : ∀ x, κ (σ x) = algebraMap (Algebra.adjoin ℚ (Set.range t))
      (IntermediateField.adjoin ℚ (Set.range t)) x := by
    intro x
    show algebraMap _ _ (ht.aevalEquiv (ht.aevalEquiv.symm x)) = _
    rw [AlgEquiv.apply_symm_apply]
  have hM : ((IsLocalization.integerNormalization
      (nonZeroDivisors (Algebra.adjoin ℚ (Set.range t)))
      (minpoly (IntermediateField.adjoin ℚ (Set.range t)) α)).map σ).map κ =
      C (κ (σ c)) * minpoly (IntermediateField.adjoin ℚ (Set.range t)) α := by
    rw [Polynomial.map_map, show κ.comp σ = algebraMap (Algebra.adjoin ℚ (Set.range t))
      (IntermediateField.adjoin ℚ (Set.range t)) from RingHom.ext hκσ, hN, hκσ,
      ← algebraMap_smul (IntermediateField.adjoin ℚ (Set.range t)) c, Polynomial.smul_eq_C_mul]
  have hb0 : σ c ≠ 0 := fun h =>
    hc0 (ht.aevalEquiv.symm.injective (h.trans (map_zero ht.aevalEquiv.symm).symm))
  have hθK : ∀ a, algebraMap (IntermediateField.adjoin ℚ (Set.range t)) K (κ a) =
      MvPolynomial.eval₂Hom (algebraMap ℚ K) t a := fun a => ht.algebraMap_aevalEquiv a
  have hinjK : Function.Injective (MvPolynomial.eval₂Hom (algebraMap ℚ K) t) :=
    algebraicIndependent_iff_injective_aeval.1 ht
  refine ⟨α, (IsLocalization.integerNormalization
      (nonZeroDivisors (Algebra.adjoin ℚ (Set.range t)))
      (minpoly (IntermediateField.adjoin ℚ (Set.range t)) α)).map σ, ?_, ?_, ?_⟩
  · rw [evalAt_of_map_eq κ _ (σ c) _ hM t (algebraMap _ K) hθK α, Polynomial.eval_map,
      ← Polynomial.aeval_def, minpoly.aeval, mul_zero]
  · rw [evalAt_of_map_eq κ _ (σ c) _ (derivative_map_eq κ _ _ _ hM) t (algebraMap _ K) hθK α]
    refine mul_ne_zero (fun h => hb0 (hinjK (h.trans (map_zero _).symm))) ?_
    rw [Polynomial.eval_map, ← Polynomial.aeval_def]
    exact hsep.aeval_derivative_ne_zero (minpoly.aeval _ _)
  · intro τ β hτ hβ
    have hinj : Function.Injective (MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) τ) :=
      algebraicIndependent_iff_injective_aeval.1 hτ
    have hg : Function.Injective ((MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) τ).comp σ) :=
      hinj.comp ht.aevalEquiv.symm.injective
    have hθ : ∀ a, IsFractionRing.lift hg (κ a) =
        MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) τ a := by
      intro a
      show IsFractionRing.lift hg (algebraMap _ _ (ht.aevalEquiv a)) = _
      rw [IsFractionRing.lift_algebraMap]
      show MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) τ (ht.aevalEquiv.symm (ht.aevalEquiv a)) = _
      rw [AlgEquiv.symm_apply_apply]
    rw [evalAt_of_map_eq κ _ (σ c) _ hM τ (IsFractionRing.lift hg) hθ β] at hβ
    have hb' : MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) τ (σ c) ≠ 0 :=
      fun h => hb0 (hinj (h.trans (map_zero _).symm))
    have hroot := (mul_eq_zero.1 hβ).resolve_left hb'
    rw [Polynomial.eval_map] at hroot
    exact ⟨((AdjoinRoot.lift _ β hroot).comp
      (IntermediateField.adjoinRootEquivAdjoin _ hint).symm.toRingEquiv.toRingHom).comp
      (((IntermediateField.equivOfEq hα).symm.toRingEquiv.toRingHom).comp
        (IntermediateField.topEquiv
          (F := IntermediateField.adjoin ℚ (Set.range t)) (E := K)).symm.toRingEquiv.toRingHom)⟩

/-- The subfield generated by `T`, as a field, is generated by (the preimage of) `T`. -/
theorem subfield_closure_coe_preimage {L : Type*} [Field L] (T : Set L) :
    Subfield.closure (((↑) : Subfield.closure T → L) ⁻¹' T) = ⊤ := by
  refine eq_top_iff.2 ?_
  rintro ⟨x, hx⟩ -
  induction hx using Subfield.closure_induction with
  | mem x hx => exact Subfield.subset_closure hx
  | one => exact Subfield.one_mem _
  | add x y hx hy ihx ihy => exact Subfield.add_mem _ ihx ihy
  | neg x hx ihx => exact Subfield.neg_mem _ ihx
  | inv x hx ihx => exact Subfield.inv_mem _ ihx
  | mul x y hx hy ihx ihy => exact Subfield.mul_mem _ ihx ihy

/-- A field of characteristic `0` generated by a finite set `s` is finite over `ℚ(t)` for an
algebraically independent family `t` (a transcendence basis chosen in `s`). -/
theorem exists_transcendence_data {K : Type*} [Field K] [CharZero K] {s : Set K} (hs : s.Finite)
    (hgen : Subfield.closure s = ⊤) :
    ∃ (d : ℕ) (t : Fin d → K), AlgebraicIndependent ℚ t ∧
      FiniteDimensional (IntermediateField.adjoin ℚ (Set.range t)) K := by
  classical
  have hadj : IntermediateField.adjoin ℚ s = ⊤ := by
    refine eq_top_iff.2 fun x _ => ?_
    have hx : x ∈ Subfield.closure s := hgen ▸ Subfield.mem_top x
    have hx' : x ∈ (IntermediateField.adjoin ℚ s).toSubfield := by
      rw [IntermediateField.adjoin_toSubfield]
      exact Subfield.closure_mono Set.subset_union_right hx
    exact hx'
  have halg : Algebra.IsAlgebraic (Algebra.adjoin ℚ s) K := by
    refine ⟨fun x => ?_⟩
    have hx : x ∈ IntermediateField.adjoin ℚ s := hadj ▸ IntermediateField.mem_top
    obtain ⟨r, hr, q, hq, rfl⟩ := IntermediateField.mem_adjoin_iff_div.1 hx
    have h1 : IsAlgebraic (Algebra.adjoin ℚ s) r :=
      isAlgebraic_algebraMap (⟨r, hr⟩ : Algebra.adjoin ℚ s)
    have h2 : IsAlgebraic (Algebra.adjoin ℚ s) q :=
      isAlgebraic_algebraMap (⟨q, hq⟩ : Algebra.adjoin ℚ s)
    rw [div_eq_mul_inv]
    exact h1.mul (IsAlgebraic.inv_iff.2 h2)
  obtain ⟨u, hus, hu⟩ := exists_isTranscendenceBasis_subset (R := ℚ) s
  have hufin : u.Finite := hs.subset hus
  let : Fintype u := hufin.fintype
  refine ⟨Fintype.card u, fun i => ((Fintype.equivFin u).symm i : K), ?_, ?_⟩
  · exact (algebraicIndependent_equiv (Fintype.equivFin u).symm).2 hu.1
  · have hrange : Set.range (fun i => ((Fintype.equivFin u).symm i : K)) = u := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩; exact ((Fintype.equivFin u).symm i).2
      · intro hx; exact ⟨Fintype.equivFin u ⟨x, hx⟩, by simp⟩
    rw [hrange]
    have h1 : Algebra.IsAlgebraic (IntermediateField.adjoin ℚ u) K := by
      have := hu.isAlgebraic_field
      rwa [Subtype.range_coe] at this
    have h2 : IntermediateField.adjoin (IntermediateField.adjoin ℚ u) s = ⊤ :=
      IntermediateField.adjoin_eq_top_of_adjoin_eq_top ℚ hadj
    have : Finite s := hs.to_subtype
    have h3 : FiniteDimensional (IntermediateField.adjoin ℚ u)
        (IntermediateField.adjoin (IntermediateField.adjoin ℚ u) s) :=
      IntermediateField.finiteDimensional_adjoin fun x _ =>
        (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
    rw [h2] at h3
    exact Module.Finite.equiv (IntermediateField.topEquiv
      (F := IntermediateField.adjoin ℚ u) (E := K)).toLinearEquiv

end

end HilbertFoundations
