import HilbertFoundations.Constructions
import HilbertFoundations.ConstructionsCloseAux5
import HilbertFoundations.ConstructionsCloseAux6

/-!
# Helper module for `ConstructionsClose.lean`: Theorem 44 in the case Hilbert demonstrates

This module contains no unit of Hilbert's text. Hilbert proves Theorem 44 "merely for the case where
the co-ordinates of the given points are rational functions, having rational coefficients, of a
single parameter `p`". The domain `R` generated by the coordinates of the given points is then a
subfield of `ℚ(p)`, not necessarily `ℚ(p)` itself (given points `(p², 0)`, say). By **Lüroth's
theorem** (mathlib: `RatFunc.Luroth.eq_adjoin_generator`) such a subfield is again generated by a
single number `q`, so Theorem 44 with one parameter (`theorem44For_singleton`) applies to it:

* `adjoin_eq_simple_of_subset_transcendental`, `closure_eq_singleton_of_transcendental`: for `p`
  transcendental and `S ⊆ ℚ(p)`, `ℚ(S) = ℚ(q)` for some real `q`;
* `theorem43For_of_subset_singleton`, `theorem44For_of_subset_singleton`: Theorem 43 for the
  domain `ℚ(S)` and Theorem 44 over it, for every finite set `S` of numbers of `ℚ(p)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace HilbertFoundations

open Polynomial IntermediateField

/-- The numbers of `ℚ(p)`, `p` algebraic, are algebraic. -/
theorem isAlgebraic_of_mem_closure_singleton {p x : ℝ} (hp : IsAlgebraic ℚ p)
    (hx : x ∈ Subfield.closure ({p} : Set ℝ)) : IsAlgebraic ℚ x := by
  have hle : Subfield.closure ({p} : Set ℝ) ≤ (algebraicClosure ℚ ℝ).toSubfield := by
    rw [Subfield.closure_le]
    intro y hy
    rw [Set.mem_singleton_iff.1 hy]
    exact mem_algebraicClosure_iff.2 hp
  exact mem_algebraicClosure_iff.1 (hle hx)

/-- **Lüroth's theorem**, for a simple transcendental extension `K(p)` inside a field `L`: an
intermediate field of `K(p)/K` generated by a set `S` is generated by a single element. -/
theorem adjoin_eq_simple_of_subset_transcendental {K L : Type*} [Field K] [Field L] [Algebra K L]
    {p : L} (hp : Transcendental K p) (S : Set L) (hS : S ⊆ (K⟮p⟯ : Set L)) :
    ∃ q : L, IntermediateField.adjoin K S = K⟮q⟯ := by
  let φ := RatFunc.algEquivOfTranscendental p hp
  let ψ : RatFunc K →ₐ[K] L := (K⟮p⟯).val.comp (φ : RatFunc K →ₐ[K] K⟮p⟯)
  have hF : IntermediateField.adjoin K S ≤ ψ.fieldRange := by
    rw [IntermediateField.adjoin_le_iff]
    intro x hx
    refine AlgHom.mem_fieldRange.2 ⟨φ.symm ⟨x, hS hx⟩, ?_⟩
    show ((φ (φ.symm ⟨x, hS hx⟩) : K⟮p⟯) : L) = x
    rw [AlgEquiv.apply_symm_apply]
  have h1 : ((IntermediateField.adjoin K S).comap ψ).map ψ = IntermediateField.adjoin K S :=
    IntermediateField.map_comap_eq_self hF
  have h2 := RatFunc.Luroth.eq_adjoin_generator (E := (IntermediateField.adjoin K S).comap ψ)
  refine ⟨ψ (RatFunc.Luroth.generator ((IntermediateField.adjoin K S).comap ψ)), ?_⟩
  have h := congrArg (fun E' : IntermediateField K (RatFunc K) => E'.map ψ) h2
  beta_reduce at h
  rw [h1, IntermediateField.adjoin_map, Set.image_singleton] at h
  exact h

/-- **Lüroth's theorem for the domains of one parameter**: a subfield of `ℚ(p)`, `p`
transcendental, generated by a set `S` of rational functions of `p` is generated by a single
one. -/
theorem closure_eq_singleton_of_transcendental {p : ℝ} (hp : Transcendental ℚ p) (S : Set ℝ)
    (hS : S ⊆ Subfield.closure ({p} : Set ℝ)) :
    ∃ q : ℝ, Subfield.closure S = Subfield.closure ({q} : Set ℝ) := by
  obtain ⟨q, hq⟩ := adjoin_eq_simple_of_subset_transcendental hp S fun x hx => by
    have h := hS hx
    rw [← adjoin_toSubfield_eq_closure] at h
    exact h
  refine ⟨q, ?_⟩
  rw [← adjoin_toSubfield_eq_closure, ← adjoin_toSubfield_eq_closure]
  exact congrArg IntermediateField.toSubfield hq

/-- **Theorem 43 for the domain generated by rational functions of one parameter**: for a finite
set `S` of numbers of `ℚ(p)`, every number of `ℚ(S)` that is nonnegative under every real embedding
of `ℚ(S)` is a quotient of two sums of squares of numbers of `ℚ(S)`. -/
theorem theorem43For_of_subset_singleton (p : ℝ) (S : Finset ℝ)
    (hS : ∀ x ∈ S, x ∈ Subfield.closure ({p} : Set ℝ)) :
    Theorem43For (Subfield.closure (S : Set ℝ)) := by
  by_cases hp : IsAlgebraic ℚ p
  · have : Finite (S : Set ℝ) := S.finite_toSet.to_subtype
    exact theorem43For_of_algebraic (S : Set ℝ) fun x hx =>
      isAlgebraic_of_mem_closure_singleton hp (hS x (Finset.mem_coe.1 hx))
  · obtain ⟨q, hq⟩ := closure_eq_singleton_of_transcendental hp (S : Set ℝ)
      fun x hx => hS x (Finset.mem_coe.1 hx)
    rw [hq]
    exact theorem43For_singleton q

/-- **Theorem 44 in the case that Hilbert demonstrates**: the coordinates of the given points (the
finite set `S`) are rational functions, with rational coefficients, of a single parameter `p`. -/
theorem theorem44For_of_subset_singleton (p : ℝ) (S : Finset ℝ)
    (hS : ∀ x ∈ S, x ∈ Subfield.closure ({p} : Set ℝ)) :
    Theorem44For (Subfield.closure (S : Set ℝ)) :=
  theorem44For_of_theorem43For _ (theorem43For_of_subset_singleton p S hS)

end HilbertFoundations
