import HilbertFoundations.Congruence

/-!
# Helper module for `CongruenceClose.lean`: distance-preserving maps of planes

This module contains no unit of Hilbert's text. It prepares the proof of Theorem 18 (congruent
figures in space). A map `φ` is *distance-preserving* on a set `D` (`IsoOn D φ`) when distinct points
of `D` have distinct images at a congruent distance. In a plane frame, with groups I, II, IV:

* `Frame.gen_plane`: a set of points of a plane that contains three non-collinear points and, with
  two points, every point of their line, is the whole plane (Pasch);
* `Frame.iso_outside_line`, `Frame.iso_outside`: if `φ` is distance-preserving on a plane `S` and a point `D` off `S` has the
  distances of `D'` from the images of three non-collinear points of `S`, then it has them from the
  images of all points of `S` (the congruence theorems on the triangles `X Y D`);
* `Frame.plane_iso`: two triangles with congruent sides, in planes `S`, `S'`, determine a
  distance-preserving map of `S` into `S'` (Theorem 17);
* `Frame.eq_of_equidistant_space`: a point with the distances of a point of a plane from three
  non-collinear points of that plane is that point.
-/

set_option linter.unusedSectionVars false

namespace HilbertFoundations

universe u v w

/-- `φ` is **distance-preserving** on `D`: distinct points of `D` have distinct images, at a
congruent distance. -/
def IsoOn {P : Type u} [HasSegCong P] (D : Set P) (φ : P → P) : Prop :=
  ∀ X ∈ D, ∀ Y ∈ D, X ≠ Y → φ X ≠ φ Y ∧ SegCong X Y (φ X) (φ Y)

namespace Frame

variable {P : Type u} {L : Type v} [HasLines P L] [HasBetween P] [HasSegCong P] [HasAngCong P]
  [hT : TriangleCongruence P L] (F : Frame P L) {S S' : Set P} {φ : P → P}
  {A B C D A' B' C' D' X Y Z X' Y' Z' : P}
include hT F

/-- Three points with the distances of three collinear points are collinear (converse form). -/
theorem col_rev (hXY : X ≠ Y) (hYZ : Y ≠ Z) (hXZ : X ≠ Z) (hXY' : X' ≠ Y') (hYZ' : Y' ≠ Z')
    (hXZ' : X' ≠ Z') (s1 : SegCong X Y X' Y') (s2 : SegCong Y Z Y' Z') (s3 : SegCong X Z X' Z')
    (h : Collinear (Line := L) X' Y' Z') : Collinear (Line := L) X Y Z :=
  F.collinear_of_segCong' h hXY' hYZ' hXZ' hXY hYZ hXZ (segCong_symm (L := L) hXY hXY' s1)
    (segCong_symm (L := L) hYZ hYZ' s2) (segCong_symm (L := L) hXZ hXZ' s3)

theorem iso_collinear (hφ : IsoOn S φ) (hX : X ∈ S) (hY : Y ∈ S) (hZ : Z ∈ S) (hXY : X ≠ Y)
    (hYZ : Y ≠ Z) (hXZ : X ≠ Z) (h : Collinear (Line := L) X Y Z) :
    Collinear (Line := L) (φ X) (φ Y) (φ Z) :=
  F.collinear_of_segCong' h hXY hYZ hXZ (hφ X hX Y hY hXY).1 (hφ Y hY Z hZ hYZ).1
    (hφ X hX Z hZ hXZ).1 (hφ X hX Y hY hXY).2 (hφ Y hY Z hZ hYZ).2 (hφ X hX Z hZ hXZ).2

theorem iso_not_collinear (hφ : IsoOn S φ) (hX : X ∈ S) (hY : Y ∈ S) (hZ : Z ∈ S)
    (h : ¬Collinear (Line := L) X Y Z) : ¬Collinear (Line := L) (φ X) (φ Y) (φ Z) := by
  obtain ⟨hXY, hZY, hXZ⟩ := F.ne h
  exact fun hc => h (F.col_rev hXY hZY.symm hXZ (hφ X hX Y hY hXY).1 (hφ Y hY Z hZ hZY.symm).1
    (hφ X hX Z hZ hXZ).1 (hφ X hX Y hY hXY).2 (hφ Y hY Z hZ hZY.symm).2 (hφ X hX Z hZ hXZ).2 hc)

theorem iso_between (hφ : IsoOn S φ) (hX : X ∈ S) (hY : Y ∈ S) (hZ : Z ∈ S)
    (h : Between X Y Z) : Between (φ X) (φ Y) (φ Z) := by
  have hXY := ne12_of_between (Line := L) h
  have hYZ := ne23_of_between (Line := L) h
  have hXZ := ne13_of_between (Line := L) h
  exact between_of_segCong h (F.iso_collinear hφ hX hY hZ hXY hYZ hXZ (collinear_of_between h))
    (hφ X hX Y hY hXY).1 (hφ Y hY Z hZ hYZ).1 (hφ X hX Z hZ hXZ).1 (hφ X hX Y hY hXY).2
    (hφ Y hY Z hZ hYZ).2 (hφ X hX Z hZ hXZ).2

theorem iso_between_rev (hφ : IsoOn S φ) (hX : X ∈ S) (hY : Y ∈ S) (hZ : Z ∈ S) (hXY : X ≠ Y)
    (hYZ : Y ≠ Z) (hXZ : X ≠ Z) (hc : Collinear (Line := L) X Y Z)
    (h : Between (φ X) (φ Y) (φ Z)) : Between X Y Z :=
  between_of_segCong h hc hXY hYZ hXZ
    (segCong_symm (L := L) hXY (hφ X hX Y hY hXY).1 (hφ X hX Y hY hXY).2)
    (segCong_symm (L := L) hYZ (hφ Y hY Z hZ hYZ).1 (hφ Y hY Z hZ hYZ).2)
    (segCong_symm (L := L) hXZ (hφ X hX Z hZ hXZ).1 (hφ X hX Z hZ hXZ).2)

/-- A distance-preserving map carries half-rays to half-rays. -/
theorem iso_ray (hφ : IsoOn S φ) (hX : X ∈ S) (hY : Y ∈ S) (hZ : Z ∈ S) (hXY : X ≠ Y)
    (hYZ : Y ≠ Z) (hXZ : X ≠ Z) (hc : Collinear (Line := L) X Y Z) :
    Z ∈ ray X Y ↔ φ Z ∈ ray (φ X) (φ Y) := by
  have hc' := F.iso_collinear hφ hX hY hZ hXY hYZ hXZ hc
  constructor
  · rintro ⟨-, -, -, hnb⟩
    exact ⟨(hφ X hX Y hY hXY).1.symm, (hφ X hX Z hZ hXZ).1.symm, hc'.swap12,
      fun hb => hnb (F.iso_between_rev hφ hY hX hZ hXY.symm hXZ hYZ hc.swap12 hb)⟩
  · rintro ⟨-, -, -, hnb⟩
    exact ⟨hXY.symm, hXZ.symm, hc.swap12, fun hb => hnb (F.iso_between hφ hY hX hZ hb)⟩

/-- **A plane is generated by three non-collinear points**: a property of points that holds for
three non-collinear points of a plane and passes from two points to every point of their line holds
for every point of the plane. -/
theorem gen_plane (hS : F.IsPl S) (hA : A ∈ S) (hB : B ∈ S) (hC : C ∈ S)
    (hn : ¬Collinear (Line := L) A B C) {G : P → Prop} (gA : G A) (gB : G B) (gC : G C)
    (hcl : ∀ X Y Z, X ∈ S → Y ∈ S → G X → G Y → X ≠ Y → Collinear (Line := L) X Y Z → G Z)
    {Z : P} (hZ : Z ∈ S) : G Z := by
  obtain ⟨hAB, hCB, hAC⟩ := F.ne hn
  by_cases h1 : Collinear (Line := L) A B Z
  · exact hcl A B Z hA hB gA gB hAB h1
  by_cases h2 : Collinear (Line := L) B C Z
  · exact hcl B C Z hB hC gB gC hCB.symm h2
  by_cases h3 : Collinear (Line := L) A C Z
  · exact hcl A C Z hA hC gA gC hAC h3
  obtain ⟨M, hM⟩ := exists_between (Line := L) hCB.symm
  have hMS : M ∈ S := F.memS_of_between hS hB hC hM
  have gM : G M := hcl B C M hB hC gB gC hCB.symm (collinear_of_between hM).swap23
  have hZM : Z ≠ M := fun e => h2 (e ▸ (collinear_of_between hM).swap23)
  obtain ⟨g, hBg, hMg, hCg⟩ := collinear_of_between hM
  have hAg : A ∉ g := fun h => hn ⟨g, h, hBg, hCg⟩
  by_cases h4 : Collinear (Line := L) A M Z
  · exact hcl A M Z hA hMS gA gM (fun e => hAg (e ▸ hMg)) h4
  set l := line (Line := L) M Z hZM.symm with hl
  have hMl : M ∈ l := mem_line_left _
  have hZl : Z ∈ l := mem_line_right _
  have hlS : LineIn l S := F.lineIn hS hMS hZ hZM.symm
  have hAl : A ∉ l := fun h => h4 (collinear_of_mem h hMl hZl)
  have hBl : B ∉ l := fun h => h2 (collinear_of_mem h (mem_right_of_between hM h hMl) hZl)
  have hCl : C ∉ l := fun h => h2 (collinear_of_mem (mem_left_of_between hM hMl h) h hZl)
  rcases F.pasch S hS B C A M l hlS hB hC hA (fun hc => hn hc.perm312) hBl hCl hAl hMl hM with
    ⟨Y, hY, hCYA⟩ | ⟨Y, hY, hBYA⟩
  · have hYS : Y ∈ S := F.memS_of_between hS hC hA hCYA
    have gY : G Y := hcl C A Y hC hA gC gA hAC.symm (collinear_of_between hCYA).swap23
    have hYM : Y ≠ M := fun e => hAg (mem_right_of_between (e ▸ hCYA) hCg hMg)
    exact hcl M Y Z hMS hYS gM gY hYM.symm (collinear_of_mem hMl hY hZl)
  · have hYS : Y ∈ S := F.memS_of_between hS hB hA hBYA
    have gY : G Y := hcl B A Y hB hA gB gA hAB.symm (collinear_of_between hBYA).swap23
    have hYM : Y ≠ M := fun e => hAg (mem_right_of_between (e ▸ hBYA) hBg hMg)
    exact hcl M Y Z hMS hYS gM gY hYM.symm (collinear_of_mem hMl hY hZl)

/-- A point `D` off a plane with the distances of `D'` from the images of two points `X`, `Y` of
the plane has them from the image of every point of the line `XY` (Theorems 10, 12, 16 on the
triangle `X Y D`). -/
theorem iso_outside_line (hS : F.IsPl S) (hφ : IsoOn S φ) (hX : X ∈ S) (hY : Y ∈ S)
    (hXY : X ≠ Y) (hD : D ∉ S) (gX : D' ≠ φ X ∧ SegCong D X D' (φ X))
    (gY : D' ≠ φ Y ∧ SegCong D Y D' (φ Y)) (hc : Collinear (Line := L) X Y Z) :
    D' ≠ φ Z ∧ SegCong D Z D' (φ Z) := by
  have hZS : Z ∈ S := F.memS_of_collinear hS hX hY hXY hc
  by_cases hZX : Z = X
  · rw [hZX]; exact gX
  by_cases hZY : Z = Y
  · rw [hZY]; exact gY
  obtain ⟨hXY', sXY⟩ := hφ X hX Y hY hXY
  obtain ⟨hXZ', sXZ⟩ := hφ X hX Z hZS (Ne.symm hZX)
  have hDX : D ≠ X := fun e => hD (e ▸ hX)
  have hDY : D ≠ Y := fun e => hD (e ▸ hY)
  have sXD : SegCong X D (φ X) D' := segCong_swap (L := L) gX.2
  have sYD : SegCong Y D (φ Y) D' := segCong_swap (L := L) gY.2
  have nXYD : ¬Collinear (Line := L) X Y D := fun h => hD (F.memS_of_collinear hS hX hY hXY h)
  have nXYD' : ¬Collinear (Line := L) (φ X) (φ Y) D' := fun h =>
    nXYD (F.col_rev hXY hDY.symm hDX.symm hXY' gY.1.symm gX.1.symm sXY sYD sXD h)
  have ang := (F.sss nXYD nXYD' sXY sXD sYD).1
  have hc' := F.iso_collinear hφ hX hY hZS hXY (Ne.symm hZY) (Ne.symm hZX) hc
  have s := F.seg_line_off hXY hXY' hc hZX hc' hXZ'.symm
    (F.iso_ray hφ hX hY hZS hXY (Ne.symm hZY) (Ne.symm hZX) hc) (fun h => nXYD h.swap12)
    (fun h => nXYD' h.swap12) ang sXZ sXD
  exact ⟨fun e => nXYD' (by rw [e]; exact hc'), segCong_swap (L := L) s⟩

/-- **A point off a plane and a distance-preserving map of the plane**: if `D ∉ S` has the
distances of `D'` from the images of three non-collinear points of `S`, it has them from the image
of every point of `S`. -/
theorem iso_outside (hS : F.IsPl S) (hφ : IsoOn S φ) {X₁ X₂ X₃ : P} (h1 : X₁ ∈ S) (h2 : X₂ ∈ S)
    (h3 : X₃ ∈ S) (hn : ¬Collinear (Line := L) X₁ X₂ X₃) (hD : D ∉ S)
    (d1 : D' ≠ φ X₁ ∧ SegCong D X₁ D' (φ X₁)) (d2 : D' ≠ φ X₂ ∧ SegCong D X₂ D' (φ X₂))
    (d3 : D' ≠ φ X₃ ∧ SegCong D X₃ D' (φ X₃)) {Z : P} (hZ : Z ∈ S) :
    D' ≠ φ Z ∧ SegCong D Z D' (φ Z) :=
  F.gen_plane hS h1 h2 h3 hn (G := fun Z => D' ≠ φ Z ∧ SegCong D Z D' (φ Z)) d1 d2 d3
    (fun _ _ _ hX hY gX gY hXY hc => F.iso_outside_line hS hφ hX hY hXY hD gX gY hc) hZ

/-- A point `X` of space with the distances of a point `Y` of a plane from three non-collinear
points of that plane is the point `Y`. -/
theorem eq_of_equidistant_space (hS : F.IsPl S) {G₁ G₂ G₃ : P} (h1 : G₁ ∈ S) (h2 : G₂ ∈ S)
    (h3 : G₃ ∈ S) (hY : Y ∈ S) (hn : ¬Collinear (Line := L) G₁ G₂ G₃) (hY1 : Y ≠ G₁)
    (hY2 : Y ≠ G₂) (hY3 : Y ≠ G₃) (hX1 : X ≠ G₁) (hX2 : X ≠ G₂) (hX3 : X ≠ G₃)
    (s1 : SegCong G₁ Y G₁ X) (s2 : SegCong G₂ Y G₂ X) (s3 : SegCong G₃ Y G₃ X) : X = Y := by
  have hXS := F.memS_of_equidistant hS h1 h2 h3 hY hn hY1 hY2 hY3 hX1 hX2 hX3 s1 s2 s3
  exact F.eq_of_equidistant hS h1 h2 h3 hXS hY hn hX1 hX2 hX3 hY1 hY2 hY3
    (segCong_symm (L := L) hY1.symm hX1.symm s1) (segCong_symm (L := L) hY2.symm hX2.symm s2)
    (segCong_symm (L := L) hY3.symm hX3.symm s3)

/-- **The distance-preserving map of a plane determined by two triangles with congruent sides.** -/
theorem plane_iso (hS : F.IsPl S) (hS' : F.IsPl S') (hA : A ∈ S) (hB : B ∈ S) (hC : C ∈ S)
    (hn : ¬Collinear (Line := L) A B C) (hA' : A' ∈ S') (hB' : B' ∈ S') (hC' : C' ∈ S')
    (hAB' : A' ≠ B') (hAC' : A' ≠ C') (hBC' : B' ≠ C') (sAB : SegCong A B A' B')
    (sAC : SegCong A C A' C') (sBC : SegCong B C B' C') :
    ∃ φ : P → P, φ A = A' ∧ φ B = B' ∧ φ C = C' ∧ (∀ X ∈ S, φ X ∈ S') ∧ IsoOn S φ := by
  obtain ⟨hAB, hCB, hAC⟩ := F.ne hn
  have hn' : ¬Collinear (Line := L) A' B' C' := fun h =>
    hn (F.col_rev hAB hCB.symm hAC hAB' hBC' hAC' sAB sBC sAC h)
  set f : Fin 3 → P := ![A, B, C] with hf
  set g : Fin 3 → P := ![A', B', C'] with hg
  have hfi : Function.Injective f := injective_fin3 hAB hAC hCB.symm
  have hgi : Function.Injective g := injective_fin3 hAB' hAC' hBC'
  have hseg : ∀ i j, i ≠ j → SegCong (f i) (f j) (g i) (g j) := by
    intro i j hij
    fin_cases i <;> fin_cases j
    · exact absurd rfl hij
    · exact sAB
    · exact sAC
    · exact segCong_swap (L := L) sAB
    · exact absurd rfl hij
    · exact sBC
    · exact segCong_swap (L := L) sAC
    · exact segCong_swap (L := L) sBC
    · exact absurd rfl hij
  have hfS : ∀ i, f i ∈ S := by
    intro i; fin_cases i
    exacts [hA, hB, hC]
  have hgS : ∀ i, g i ∈ S' := by
    intro i; fin_cases i
    exacts [hA', hB', hC']
  have key : ∀ X, ∃ X', X ∈ S → (∀ i, X ≠ f i) →
      X' ∈ S' ∧ (∀ i, X' ≠ g i) ∧ ∀ i, SegCong (f i) X (g i) X' := by
    intro X
    by_cases h : X ∈ S ∧ ∀ i, X ≠ f i
    · obtain ⟨X', h1, h2, h3⟩ := F.theorem17_exists hS hS' hfS hgS hfi hgi hseg h.1 h.2
      exact ⟨X', fun _ _ => ⟨h1, h2, h3⟩⟩
    · exact ⟨X, fun h1 h2 => absurd ⟨h1, h2⟩ h⟩
  choose φ₁ hφ₁ using key
  classical
  let φ : P → P := fun X =>
    if X = A then A' else if X = B then B' else if X = C then C' else φ₁ X
  have eA : φ A = A' := by simp [φ]
  have eB : φ B = B' := by simp [φ, hAB.symm]
  have eC : φ C = C' := by simp [φ, hAC.symm, hCB]
  have efi : ∀ i, φ (f i) = g i := by
    intro i; fin_cases i
    exacts [eA, eB, eC]
  have eoff : ∀ X, (∀ i, X ≠ f i) → φ X = φ₁ X := by
    intro X h
    have h0 : X ≠ A := h 0
    have h1 : X ≠ B := h 1
    have h2 : X ≠ C := h 2
    simp [φ, h0, h1, h2]
  have K : ∀ X ∈ S, φ X ∈ S' ∧ ∀ i, X ≠ f i → φ X ≠ g i ∧ SegCong (f i) X (g i) (φ X) := by
    intro X hX
    by_cases hb : ∃ j, X = f j
    · obtain ⟨j, hj⟩ := hb
      rw [hj, efi j]
      exact ⟨hgS j, fun i hji => ⟨hgi.ne (fun e => hji (by rw [e])),
        hseg i j (fun e => hji (by rw [e]))⟩⟩
    · push Not at hb
      rw [eoff X hb]
      obtain ⟨h1, h2, h3⟩ := hφ₁ X hX hb
      exact ⟨h1, fun i _ => ⟨h2 i, h3 i⟩⟩
  refine ⟨φ, eA, eB, eC, fun X hX => (K X hX).1, ?_⟩
  intro X hX Y hY hXY
  by_cases hy : ∃ j, Y = f j
  · obtain ⟨j, hj⟩ := hy
    obtain ⟨h1, h2⟩ := (K X hX).2 j (hj ▸ hXY)
    rw [hj, efi j]
    exact ⟨h1, segCong_swap (L := L) h2⟩
  by_cases hx : ∃ j, X = f j
  · obtain ⟨j, hj⟩ := hx
    obtain ⟨h1, h2⟩ := (K Y hY).2 j (hj ▸ hXY.symm)
    rw [hj, efi j]
    exact ⟨h1.symm, h2⟩
  push Not at hx hy
  have hc3 : CongruentFigures (L := L) f g :=
    ⟨hfi, hgi, hseg, fun i j k h h' => F.angles_of_segs hseg h h'⟩
  have hXr : X ∉ Set.range f := fun ⟨i, hi⟩ => hx i hi.symm
  have hX'r : φ X ∉ Set.range g := fun ⟨i, hi⟩ => ((K X hX).2 i (hx i)).1 hi.symm
  have hc4 := congruentFigures_snoc F hc3 hXr hX'r (fun i => ((K X hX).2 i (hx i)).2)
  have hf4S : ∀ i, (Fin.snoc f X : Fin (3 + 1) → P) i ∈ S := by
    intro i
    cases i using Fin.lastCases with
    | last => simp only [Fin.snoc_last]; exact hX
    | cast i => simp only [Fin.snoc_castSucc]; exact hfS i
  have hg4S : ∀ i, (Fin.snoc g (φ X) : Fin (3 + 1) → P) i ∈ S' := by
    intro i
    cases i using Fin.lastCases with
    | last => simp only [Fin.snoc_last]; exact (K X hX).1
    | cast i => simp only [Fin.snoc_castSucc]; exact hgS i
  have hYf4 : ∀ i, Y ≠ (Fin.snoc f X : Fin (3 + 1) → P) i := by
    intro i
    cases i using Fin.lastCases with
    | last => simp only [Fin.snoc_last]; exact hXY.symm
    | cast i => simp only [Fin.snoc_castSucc]; exact hy i
  obtain ⟨Y'', hY''S, hY''g, hs⟩ := F.theorem17_exists hS hS' hf4S hg4S hc4.1 hc4.2.1 hc4.2.2.1
    hY hYf4
  have n1 : ∀ i : Fin 3, Y'' ≠ g i := fun i => by
    have := hY''g (Fin.castSucc i)
    simpa only [Fin.snoc_castSucc] using this
  have t : ∀ i : Fin 3, SegCong (g i) Y'' (g i) (φ Y) := fun i => by
    have h1 := hs (Fin.castSucc i)
    simp only [Fin.snoc_castSucc] at h1
    exact SegmentCongruence.ax_IV2 (Line := L) (f i) Y (g i) Y'' (g i) (φ Y) (hy i).symm
      (n1 i).symm ((K Y hY).2 i (hy i)).1.symm h1 ((K Y hY).2 i (hy i)).2
  have e : Y'' = φ Y := F.eq_of_equidistant hS' hA' hB' hC' hY''S (K Y hY).1 hn' (n1 0) (n1 1)
    (n1 2) ((K Y hY).2 0 (hy 0)).1 ((K Y hY).2 1 (hy 1)).1 ((K Y hY).2 2 (hy 2)).1 (t 0) (t 1)
    (t 2)
  have hl := hs (Fin.last 3)
  have hl' := hY''g (Fin.last 3)
  simp only [Fin.snoc_last] at hl hl'
  rw [e] at hl hl'
  exact ⟨hl'.symm, hl⟩

end Frame

end HilbertFoundations
