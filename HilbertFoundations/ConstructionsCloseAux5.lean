import HilbertFoundations.Constructions
import HilbertFoundations.ConstructionsCloseAux3
import HilbertFoundations.ConstructionsCloseAux4

/-!
# Helper module for `ConstructionsClose.lean`: Theorem 44 with one parameter

This module contains no unit of Hilbert's text. For a subfield `R` of `ℝ` (the domain generated by
the coordinates of the given points), `Theorem43For R` says that every number of `R` that is
nonnegative under every real embedding of `R` is a quotient of two sums of squares in `R`, and
`Theorem44For R` is Theorem 44 over `R` (see `ConstructionsAux9`, `ConstructionsAux10`).

* `theorem43For_of_algebraic`: `Theorem43For R` for `R` generated by finitely many algebraic
  numbers (`R` is a number field, and a totally positive number is a sum of squares);
* `theorem43For_transcendental`: `Theorem43For ℚ(t)` for a transcendental `t` — this is Theorem 43:
  a number `N(t)/D(t)` that is nonnegative under the embeddings `t ↦ c` (`c` transcendental) gives
  a polynomial `N D` that never becomes negative (the transcendental numbers are dense), hence a
  sum of squares;
* `theorem44For_singleton`: **Theorem 44 with one parameter**, `R = ℚ(p)` for an arbitrary real
  `p` — the case that Hilbert proves;
* `theorem44For_of_algebraic`: Theorem 44 for given points with algebraic coordinates;
* `theorem43For_of_theorem44For`: conversely, Theorem 44 over `R` implies `Theorem43For R` (apply
  it to the tower `√g`; a sum of squares in `F(√(x² + y²))` that lies in `R` is a sum of squares
  in `F`), so that `Theorem44 ↔ ∀ S, Theorem43For ℚ(S)` (`theorem44_iff_theorem43For`): the general
  case of Theorem 44 is *equivalent* to the generalization of Theorem 43 to several parameters.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace HilbertFoundations

open Polynomial

/-! ## Given points with algebraic coordinates -/

theorem adjoin_toSubfield_eq_closure (S : Set ℝ) :
    (IntermediateField.adjoin ℚ S).toSubfield = Subfield.closure S := by
  rw [IntermediateField.adjoin_toSubfield]
  apply le_antisymm
  · rw [Subfield.closure_le]
    rintro x (⟨q, rfl⟩ | hx)
    · rw [eq_ratCast]; exact SubfieldClass.ratCast_mem _ q
    · exact Subfield.subset_closure hx
  · exact Subfield.closure_mono Set.subset_union_right

theorem sosIn_of_isSumSq {E : IntermediateField ℚ ℝ} {R : Subfield ℝ} (hE : E.toSubfield = R)
    {x : E} (h : IsSumSq x) : SOSIn R (x : ℝ) := by
  induction h with
  | zero => simpa using (SOSIn.zero : SOSIn R 0)
  | @sq_add a s _ ih =>
    have ha : (a : ℝ) ∈ R := by rw [← hE]; exact a.2
    have e : ((a * a + s : E) : ℝ) = (a : ℝ) ^ 2 + (s : ℝ) := by push_cast; ring
    rw [e]; exact .cons ha ih

theorem sosIn_one (R : Subfield ℝ) : SOSIn R 1 := by
  simpa using SOSIn.sq R.one_mem

/-- **Theorem 43 for a domain generated by finitely many algebraic numbers**: a number of the
number field `R` that is nonnegative under every real embedding of `R` is a sum of squares of
numbers of `R`. -/
theorem theorem43For_of_algebraic (S : Set ℝ) [Finite S] (hS : ∀ x ∈ S, IsAlgebraic ℚ x) :
    Theorem43For (Subfield.closure S) := by
  rintro g ⟨hg, hσ⟩
  set E : IntermediateField ℚ ℝ := IntermediateField.adjoin ℚ S with hEdef
  have hE : E.toSubfield = Subfield.closure S := adjoin_toSubfield_eq_closure S
  have : FiniteDimensional ℚ E :=
    IntermediateField.finiteDimensional_adjoin (K := ℚ) (S := S) fun x hx => (hS x hx).isIntegral
  have : NumberField E := NumberField.of_module_finite ℚ E
  by_cases hg0 : g = 0
  · exact ⟨0, 1, .zero, sosIn_one _, one_ne_zero, by simp [hg0]⟩
  have hgE : g ∈ E := by
    have : g ∈ E.toSubfield := by rw [hE]; exact hg
    exact this
  have htp : TotallyPositive (⟨g, hgE⟩ : E) := by
    intro τ hτ
    let ι : Subfield.closure S →+* E := (Subfield.closure S).subtype.codRestrict E fun x => by
      have h : (x : ℝ) ∈ E.toSubfield := by rw [hE]; exact x.2
      exact h
    obtain ⟨s, hs, e⟩ := hσ (τ.comp ι) fun y _ =>
      ⟨(τ (ι y)).re, Complex.ext (by simp) (by simp [hτ (ι y)])⟩
    have e' : τ ⟨g, hgE⟩ = (s : ℂ) := e
    rw [e', Complex.ofReal_re]
    refine lt_of_le_of_ne hs fun h0 => ?_
    rw [← h0, Complex.ofReal_zero] at e'
    exact hg0 (congrArg Subtype.val ((map_eq_zero τ).1 e'))
  have hss := totallyPositive_isSumSq E ⟨g, hgE⟩ htp
  exact ⟨g, 1, sosIn_of_isSumSq hE hss, sosIn_one _, one_ne_zero, by simp⟩

/-! ## One transcendental parameter -/

/-- The numbers of `ℚ(t)` are the quotients `N(t) / D(t)`. -/
theorem mem_closure_singleton {t x : ℝ} (hx : x ∈ Subfield.closure ({t} : Set ℝ)) :
    ∃ N D : ℚ[X], aeval t D ≠ 0 ∧ x = aeval t N / aeval t D := by
  induction hx using Subfield.closure_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    exact ⟨X, 1, by simp, by simp [hx]⟩
  | one => exact ⟨1, 1, by simp, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨N, D, hD, rfl⟩ := hx
    obtain ⟨N', D', hD', rfl⟩ := hy
    refine ⟨N * D' + D * N', D * D', by rw [map_mul]; exact mul_ne_zero hD hD', ?_⟩
    rw [map_add, map_mul, map_mul, map_mul]
    exact div_add_div _ _ hD hD'
  | neg x _ hx =>
    obtain ⟨N, D, hD, rfl⟩ := hx
    exact ⟨-N, D, hD, by rw [map_neg, neg_div]⟩
  | inv x _ hx =>
    obtain ⟨N, D, hD, rfl⟩ := hx
    by_cases hN : aeval t N = 0
    · exact ⟨0, 1, by simp, by simp [hN]⟩
    · exact ⟨D, N, hN, by rw [inv_div]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨N, D, hD, rfl⟩ := hx
    obtain ⟨N', D', hD', rfl⟩ := hy
    refine ⟨N * N', D * D', by rw [map_mul]; exact mul_ne_zero hD hD', ?_⟩
    rw [map_mul, map_mul]
    exact div_mul_div_comm _ _ _ _

theorem aeval_ne_zero_of_transcendental {t c : ℝ} (hc : Transcendental ℚ c) {D : ℚ[X]}
    (hD : aeval t D ≠ 0) : aeval c D ≠ 0 := by
  intro h
  rw [transcendental_iff.1 hc D h, map_zero] at hD
  exact hD rfl

theorem specialize_wd {t c : ℝ} (ht : Transcendental ℚ t) (hc : Transcendental ℚ c)
    {N D N' D' : ℚ[X]} (hD : aeval t D ≠ 0) (hD' : aeval t D' ≠ 0)
    (h : aeval t N / aeval t D = aeval t N' / aeval t D') :
    aeval c N / aeval c D = aeval c N' / aeval c D' := by
  rw [div_eq_div_iff hD hD'] at h
  have h0 : aeval t (N * D' - N' * D) = 0 := by rw [map_sub, map_mul, map_mul, h, sub_self]
  have h2 : N * D' = N' * D := sub_eq_zero.1 (transcendental_iff.1 ht _ h0)
  rw [div_eq_div_iff (aeval_ne_zero_of_transcendental hc hD)
    (aeval_ne_zero_of_transcendental hc hD'), ← map_mul, ← map_mul, h2]

/-- The value at `t ↦ c` of a number of `ℚ(t)`. -/
noncomputable def specializeFun (t c : ℝ) (x : Subfield.closure ({t} : Set ℝ)) : ℝ :=
  aeval c (mem_closure_singleton x.2).choose /
    aeval c (mem_closure_singleton x.2).choose_spec.choose

theorem specializeFun_eq {t c : ℝ} (ht : Transcendental ℚ t) (hc : Transcendental ℚ c)
    (x : Subfield.closure ({t} : Set ℝ)) {N D : ℚ[X]} (hD : aeval t D ≠ 0)
    (h : (x : ℝ) = aeval t N / aeval t D) : specializeFun t c x = aeval c N / aeval c D := by
  obtain ⟨hD', h'⟩ := (mem_closure_singleton x.2).choose_spec.choose_spec
  exact specialize_wd ht hc hD' hD (h'.symm.trans h)

/-- For transcendental `t` and `c`, the embedding `ℚ(t) → ℝ`, `t ↦ c`: every real value of the
parameter other than an algebraic number. -/
noncomputable def specialize {t c : ℝ} (ht : Transcendental ℚ t) (hc : Transcendental ℚ c) :
    Subfield.closure ({t} : Set ℝ) →+* ℝ where
  toFun := specializeFun t c
  map_one' := by
    rw [specializeFun_eq ht hc 1 (N := 1) (D := 1) (by simp) (by simp)]; simp
  map_mul' x y := by
    obtain ⟨N, D, hD, hx⟩ := mem_closure_singleton x.2
    obtain ⟨N', D', hD', hy⟩ := mem_closure_singleton y.2
    rw [specializeFun_eq ht hc x hD hx, specializeFun_eq ht hc y hD' hy,
      specializeFun_eq ht hc (x * y) (N := N * N') (D := D * D')
        (by rw [map_mul]; exact mul_ne_zero hD hD')
        (by rw [Subfield.coe_mul, hx, hy, map_mul, map_mul]; exact div_mul_div_comm _ _ _ _),
      map_mul, map_mul]
    exact (div_mul_div_comm _ _ _ _).symm
  map_zero' := by
    rw [specializeFun_eq ht hc 0 (N := 0) (D := 1) (by simp) (by simp)]; simp
  map_add' x y := by
    obtain ⟨N, D, hD, hx⟩ := mem_closure_singleton x.2
    obtain ⟨N', D', hD', hy⟩ := mem_closure_singleton y.2
    rw [specializeFun_eq ht hc x hD hx, specializeFun_eq ht hc y hD' hy,
      specializeFun_eq ht hc (x + y) (N := N * D' + D * N') (D := D * D')
        (by rw [map_mul]; exact mul_ne_zero hD hD')
        (by rw [Subfield.coe_add, hx, hy, map_add, map_mul, map_mul, map_mul]
            exact div_add_div _ _ hD hD'),
      map_add, map_mul, map_mul, map_mul]
    exact (div_add_div _ _ (aeval_ne_zero_of_transcendental hc hD)
      (aeval_ne_zero_of_transcendental hc hD')).symm

/-- **Theorem 43 for the domain `ℚ(t)` of one parameter**: a rational function of the parameter
with rational coefficients that is nonnegative for all (transcendental) real values of the
parameter is a quotient of two sums of squares of rational functions with rational coefficients.
This is Theorem 43 applied to the numerator times the denominator. -/
theorem theorem43For_transcendental {t : ℝ} (ht : Transcendental ℚ t) :
    Theorem43For (Subfield.closure ({t} : Set ℝ)) := by
  rintro g ⟨hg, hσ⟩
  obtain ⟨N, D, hD, hgND⟩ := mem_closure_singleton hg
  have hval : ∀ c : ℝ, Transcendental ℚ c → 0 ≤ aeval c (N * D) := by
    intro c hc
    obtain ⟨s, hs, e⟩ := hσ (Complex.ofRealHom.comp (specialize ht hc))
      fun y _ => ⟨specialize ht hc y, rfl⟩
    have e' : ((specialize ht hc ⟨g, hg⟩ : ℝ) : ℂ) = (s : ℂ) := e
    have e1 : specialize ht hc ⟨g, hg⟩ = s := Complex.ofReal_injective e'
    have e2 : specialize ht hc ⟨g, hg⟩ = aeval c N / aeval c D :=
      specializeFun_eq ht hc ⟨g, hg⟩ hD hgND
    rw [e2] at e1
    have hd := aeval_ne_zero_of_transcendental hc hD
    have h3 : aeval c N * aeval c D = aeval c N / aeval c D * aeval c D ^ 2 := by
      rw [sq, ← mul_assoc, div_mul_cancel₀ _ hd]
    rw [map_mul, h3, e1]
    positivity
  have hpsd : PSD (N * D) := by
    intro x
    by_contra hneg
    push Not at hneg
    have hcont : Continuous fun y : ℝ => aeval y (N * D) := by
      have : (fun y : ℝ => aeval y (N * D)) =
          fun y => ((N * D).map (algebraMap ℚ ℝ)).eval y := funext (aeval_real_eq _)
      rw [this]; exact Polynomial.continuous _
    have hopen : IsOpen {y : ℝ | aeval y (N * D) < 0} := isOpen_lt hcont continuous_const
    have hdense : Dense {y : ℝ | IsAlgebraic ℚ y}ᶜ :=
      (Algebraic.countable (R := ℚ) (A := ℝ)).dense_compl ℝ
    obtain ⟨c, hc, hcU⟩ := hdense.exists_mem_open hopen ⟨x, hneg⟩
    exact absurd (hval c hc) (not_le.2 hcU)
  have hss := psd_isSumSq hpsd
  have tR : t ∈ Subfield.closure ({t} : Set ℝ) := Subfield.subset_closure (Set.mem_singleton t)
  refine ⟨aeval t (N * D), aeval t D ^ 2, sosIn_aeval tR hss,
    SOSIn.sq (aeval_mem_subfield tR D), pow_ne_zero 2 hD, ?_⟩
  rw [hgND, map_mul, sq, mul_div_mul_right _ _ hD]

/-- **Theorem 43 for the domain `ℚ(p)` generated by one real number `p`** (algebraic or
transcendental). -/
theorem theorem43For_singleton (t : ℝ) : Theorem43For (Subfield.closure ({t} : Set ℝ)) := by
  by_cases ht : IsAlgebraic ℚ t
  · exact theorem43For_of_algebraic {t} fun x hx => by rw [Set.mem_singleton_iff.1 hx]; exact ht
  · exact theorem43For_transcendental ht

/-- **Theorem 44 with one parameter** `p`: the domain `R = ℚ(p)`. -/
theorem theorem44For_singleton (t : ℝ) : Theorem44For (Subfield.closure ({t} : Set ℝ)) :=
  theorem44For_of_theorem43For _ (theorem43For_singleton t)

/-- **Theorem 44 for given points with algebraic coordinates** (no parameter). -/
theorem theorem44For_of_algebraic (S : Finset ℝ) (hS : ∀ x ∈ S, IsAlgebraic ℚ x) :
    Theorem44For (Subfield.closure (S : Set ℝ)) := by
  have : Finite (S : Set ℝ) := S.finite_toSet.to_subtype
  exact theorem44For_of_theorem43For _
    (theorem43For_of_algebraic (S : Set ℝ) fun x hx => hS x (Finset.mem_coe.1 hx))

/-! ## Theorem 44 implies the generalization of Theorem 43 -/

/-- Sums of squares of numbers of `F` that lie in `R` are sums of squares of numbers of `R`. -/
def SOSDescends (R F : Subfield ℝ) : Prop :=
  R ≤ F ∧ ∀ u ∈ R, SOSIn F u → SOSIn R u

/-- A sum of squares of numbers `r + s b` of `F(b)` is `A + b² B + 2 b C` with `A`, `B` sums of
squares in `F` and `C ∈ F`. -/
theorem sosIn_quadExt_repr {F E : Subfield ℝ} {b : ℝ} (hE : IsQuadExt F E b) {u : ℝ}
    (hu : SOSIn E u) :
    ∃ A B C : ℝ, SOSIn F A ∧ SOSIn F B ∧ C ∈ F ∧ u = A + b ^ 2 * B + 2 * b * C := by
  induction hu with
  | zero => exact ⟨0, 0, 0, .zero, .zero, F.zero_mem, by ring⟩
  | @cons w u hw _ ih =>
    obtain ⟨A, B, C, hA, hB, hC, rfl⟩ := ih
    obtain ⟨r, hr, s, hs, rfl⟩ := hE.repr w hw
    exact ⟨r ^ 2 + A, s ^ 2 + B, r * s + C, .cons hr hA, .cons hs hB,
      F.add_mem (F.mul_mem hr hs) hC, by ring⟩

/-- Adjoining the square root of a sum of two squares: if `u ∈ R` is a sum of squares in
`F(√(x² + y²))`, it is a sum of squares in `F`. -/
theorem SOSDescends.sqrt {R F : Subfield ℝ} (hF : SOSDescends R F) {x y z : ℝ} (hx : x ∈ F)
    (hy : y ∈ F) (hzz : z ^ 2 = x ^ 2 + y ^ 2) :
    SOSDescends R (Subfield.closure ((F : Set ℝ) ∪ {z})) := by
  have hz2 : z ^ 2 ∈ F := by rw [hzz]; exact F.add_mem (F.pow_mem hx 2) (F.pow_mem hy 2)
  have hE := quadExt_closure hz2
  by_cases hzF : z ∈ F
  · rw [hE.eq_of_mem hzF]; exact hF
  refine ⟨hF.1.trans hE.le, fun u huR hu => ?_⟩
  obtain ⟨A, B, C, hA, hB, hC, rfl⟩ := sosIn_quadExt_repr hE hu
  have hC0 : C = 0 := by
    by_contra hC0
    apply hzF
    have h1 : 2 * z * C ∈ F := by
      have : 2 * z * C = (A + z ^ 2 * B + 2 * z * C) - A - z ^ 2 * B := by ring
      rw [this]
      exact F.sub_mem (F.sub_mem (hF.1 huR) hA.mem) (F.mul_mem hz2 hB.mem)
    have h2 : z = 2 * z * C / (2 * C) := by
      rw [mul_assoc, mul_comm z C, ← mul_assoc, mul_div_cancel_left₀ _ (mul_ne_zero two_ne_zero hC0)]
    rw [h2]; exact F.div_mem h1 (F.mul_mem (two_mem_subfield F) hC)
  apply hF.2 _ huR
  rw [hC0, mul_zero, add_zero, hzz]
  exact hA.add (((SOSIn.sq hx).add (SOSIn.sq hy)).mul hB)

/-- Every number of `Ω(R)` lies in a field in which the sums of squares that lie in `R` are sums
of squares of numbers of `R`. -/
theorem sosDescends_of_pythClosure {R : Subfield ℝ} {x : ℝ} (hx : PythClosure (R : Set ℝ) x) :
    ∀ F : Subfield ℝ, SOSDescends R F →
      ∃ F' : Subfield ℝ, F ≤ F' ∧ SOSDescends R F' ∧ x ∈ F' := by
  induction hx with
  | base hb => intro F hF; exact ⟨F, le_rfl, hF, hF.1 hb⟩
  | add _ _ iha ihb =>
    intro F hF
    obtain ⟨F1, h1, hF1, ha⟩ := iha F hF
    obtain ⟨F2, h2, hF2, hb⟩ := ihb F1 hF1
    exact ⟨F2, h1.trans h2, hF2, F2.add_mem (h2 ha) hb⟩
  | sub _ _ iha ihb =>
    intro F hF
    obtain ⟨F1, h1, hF1, ha⟩ := iha F hF
    obtain ⟨F2, h2, hF2, hb⟩ := ihb F1 hF1
    exact ⟨F2, h1.trans h2, hF2, F2.sub_mem (h2 ha) hb⟩
  | mul _ _ iha ihb =>
    intro F hF
    obtain ⟨F1, h1, hF1, ha⟩ := iha F hF
    obtain ⟨F2, h2, hF2, hb⟩ := ihb F1 hF1
    exact ⟨F2, h1.trans h2, hF2, F2.mul_mem (h2 ha) hb⟩
  | div _ _ _ iha ihb =>
    intro F hF
    obtain ⟨F1, h1, hF1, ha⟩ := iha F hF
    obtain ⟨F2, h2, hF2, hb⟩ := ihb F1 hF1
    exact ⟨F2, h1.trans h2, hF2, F2.div_mem (h2 ha) hb⟩
  | @sqrt a b z _ _ hz hzz iha ihb =>
    intro F hF
    obtain ⟨F1, h1, hF1, ha⟩ := iha F hF
    obtain ⟨F2, h2, hF2, hb⟩ := ihb F1 hF1
    have hz2 : z ^ 2 ∈ F2 := by
      rw [hzz]; exact F2.add_mem (F2.pow_mem (h2 ha) 2) (F2.pow_mem hb 2)
    have hE := quadExt_closure hz2
    exact ⟨_, (h1.trans h2).trans hE.le, hF2.sqrt (h2 ha) hb hzz, hE.mem⟩

/-- **Theorem 44 over `R` implies Theorem 43 for `R`**: apply Theorem 44 to the single square
root `√g` of a number `g ∈ R` that is nonnegative for all real values of the parameters. -/
theorem theorem43For_of_theorem44For (R : Subfield ℝ) (h : Theorem44For R) : Theorem43For R := by
  rintro g ⟨hgR, hσ⟩
  have hg0 : 0 ≤ g := by
    obtain ⟨s, hs, e⟩ := hσ (Complex.ofRealHom.comp R.subtype) (fun y _ => ⟨y, rfl⟩)
    have e' : ((g : ℝ) : ℂ) = (s : ℂ) := e
    have : g = s := by exact_mod_cast e'
    rw [this]; exact hs
  have hv : ValidTowerOver R [g] := ⟨trivial, hgR, hg0⟩
  have hr : RealTowerOver R [g] := ⟨trivial, hgR, hσ⟩
  have hmem : Real.sqrt g ∈ towerFieldOver R [g] := Subfield.subset_closure (Or.inr rfl)
  have hp := (h [g] hv).1 hr _ hmem
  obtain ⟨F, -, hF, hsF⟩ := sosDescends_of_pythClosure hp R ⟨le_rfl, fun u _ hu => hu⟩
  have h2 : SOSIn F g := by
    have := SOSIn.sq hsF
    rwa [Real.sq_sqrt hg0] at this
  exact ⟨g, 1, hF.2 g hgR h2, sosIn_one R, one_ne_zero, by simp⟩

/-- Theorem 44 over `R` is equivalent to Theorem 43 for `R`. -/
theorem theorem44For_iff_theorem43For (R : Subfield ℝ) : Theorem44For R ↔ Theorem43For R :=
  ⟨theorem43For_of_theorem44For R, theorem44For_of_theorem43For R⟩

/-- **The general case of Theorem 44 is equivalent to the generalization of Theorem 43** to every
domain generated by finitely many real numbers (Hilbert's seventeenth problem for these fields). -/
theorem theorem44_iff_theorem43For :
    Theorem44 ↔ ∀ S : Finset ℝ, Theorem43For (Subfield.closure (S : Set ℝ)) :=
  ⟨fun h S => theorem43For_of_theorem44For _ (h S), theorem44_of_theorem43For⟩

end HilbertFoundations
