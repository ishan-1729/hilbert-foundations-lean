import HilbertFoundations.ConstructionsAux8

/-!
# Helper module for `Constructions.lean`: Theorem 44 over a domain `R`

This module contains no unit of Hilbert's text. For a subfield `R` of `ℝ` (the domain generated
by the coordinates of the given points, including the arbitrary parameters):

* towers of square roots over `R` (`towerFieldOver`, `ValidTowerOver`) and Hilbert's condition
  `RealTowerOver` (every radicand is a nonnegative real number under every embedding into `ℂ` that
  is real on `R`: for all real values of the parameters and either sign of each square root);
* the statement `Theorem44` of Theorem 44;
* `pyth_ext`: every embedding real on `R` extends to every number of `Ω(R)` with a real value;
* `theorem44_necessary`: the condition of Theorem 44 is necessary, for every `R`.
-/

set_option linter.unusedSectionVars false

namespace HilbertFoundations

open Coord

/-- `x` is totally nonnegative in `F` relative to `R`: every embedding of `F` into `ℂ` that is
real on `R` maps `x` to a nonnegative real number. -/
def TotNonnegOver (R F : Subfield ℝ) (x : ℝ) : Prop :=
  ∃ hx : x ∈ F, ∀ σ : F →+* ℂ, (∀ y : F, (y : ℝ) ∈ R → ∃ r : ℝ, σ y = (r : ℂ)) →
    ∃ t : ℝ, 0 ≤ t ∧ σ ⟨x, hx⟩ = (t : ℂ)

/-- The tower of square roots over `R`, the last radicand first. -/
noncomputable def towerFieldOver (R : Subfield ℝ) : List ℝ → Subfield ℝ
  | [] => R
  | a :: l => Subfield.closure ((towerFieldOver R l : Set ℝ) ∪ {Real.sqrt a})

/-- A tower of square roots over `R`: each radicand is a nonnegative number of the field obtained
before. -/
def ValidTowerOver (R : Subfield ℝ) : List ℝ → Prop
  | [] => True
  | a :: l => ValidTowerOver R l ∧ a ∈ towerFieldOver R l ∧ 0 ≤ a

/-- Hilbert's condition over `R`: every radicand is nonnegative for all real values of the
parameters and either sign of the square roots extracted before. -/
def RealTowerOver (R : Subfield ℝ) : List ℝ → Prop
  | [] => True
  | a :: l => RealTowerOver R l ∧ TotNonnegOver R (towerFieldOver R l) a

/-- Theorem 44 for the domain `R`: the numbers of a tower lie in `Ω(R)` iff Hilbert's condition
holds. -/
def Theorem44For (R : Subfield ℝ) : Prop :=
  ∀ l : List ℝ, ValidTowerOver R l →
    (RealTowerOver R l ↔ ∀ x ∈ towerFieldOver R l, PythClosure (R : Set ℝ) x)

/-- **Theorem 44**: for every domain `R` generated by the coordinates of finitely many given
points. -/
def Theorem44 : Prop := ∀ S : Finset ℝ, Theorem44For (Subfield.closure (S : Set ℝ))

theorem le_towerFieldOver (R : Subfield ℝ) : ∀ l : List ℝ, R ≤ towerFieldOver R l
  | [] => le_rfl
  | _ :: l => (le_towerFieldOver R l).trans fun _ hx => Subfield.subset_closure (Or.inl hx)

/-- **Every embedding real on `R` extends to a number of `Ω(R)` with a real value.** -/
theorem pyth_ext {R : Subfield ℝ} {x : ℝ} (hx : PythClosure (R : Set ℝ) x) :
    ∀ (F : Subfield ℝ), R ≤ F → ∀ σ : F →+* ℂ,
      (∀ y : F, (y : ℝ) ∈ R → ∃ r : ℝ, σ y = (r : ℂ)) →
      ∃ (F' : Subfield ℝ) (hle : F ≤ F') (hxF : x ∈ F') (σ' : F' →+* ℂ),
        (∀ y : F, σ' ⟨y, hle y.2⟩ = σ y) ∧ ∃ r : ℝ, σ' ⟨x, hxF⟩ = (r : ℂ) := by
  -- the extension of an embedding real on `R` is real on `R`
  have real_ext : ∀ {F F' : Subfield ℝ} (hle : F ≤ F') (σ : F →+* ℂ) (σ' : F' →+* ℂ),
      (∀ y : F, σ' ⟨y, hle y.2⟩ = σ y) → (∀ y : F, (y : ℝ) ∈ R → ∃ r : ℝ, σ y = (r : ℂ)) →
      R ≤ F → ∀ y : F', (y : ℝ) ∈ R → ∃ r : ℝ, σ' y = (r : ℂ) := by
    intro F F' hle σ σ' e hσ hRF y hy
    obtain ⟨r, hr⟩ := hσ ⟨y, hRF hy⟩ hy
    exact ⟨r, by rw [← hr, ← e ⟨y, hRF hy⟩]⟩
  induction hx with
  | base hb =>
    intro F hRF σ hσ
    exact ⟨F, le_rfl, hRF hb, σ, fun y => rfl, hσ _ hb⟩
  | @add a b _ _ iha ihb =>
    intro F hRF σ hσ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hσa⟩ := iha F hRF σ hσ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hσb⟩ :=
      ihb F1 (hRF.trans h1) σ1 (real_ext h1 σ σ1 e1 hσ hRF)
    refine ⟨F2, h1.trans h2, F2.add_mem (h2 ha1) hb2, σ2, fun y => ?_, ra + rb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a + b, F2.add_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ + ⟨b, hb2⟩ := rfl
      rw [this, map_add, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @sub a b _ _ iha ihb =>
    intro F hRF σ hσ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hσa⟩ := iha F hRF σ hσ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hσb⟩ :=
      ihb F1 (hRF.trans h1) σ1 (real_ext h1 σ σ1 e1 hσ hRF)
    refine ⟨F2, h1.trans h2, F2.sub_mem (h2 ha1) hb2, σ2, fun y => ?_, ra - rb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a - b, F2.sub_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ - ⟨b, hb2⟩ := rfl
      rw [this, map_sub, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @mul a b _ _ iha ihb =>
    intro F hRF σ hσ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hσa⟩ := iha F hRF σ hσ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hσb⟩ :=
      ihb F1 (hRF.trans h1) σ1 (real_ext h1 σ σ1 e1 hσ hRF)
    refine ⟨F2, h1.trans h2, F2.mul_mem (h2 ha1) hb2, σ2, fun y => ?_, ra * rb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a * b, F2.mul_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ * ⟨b, hb2⟩ := rfl
      rw [this, map_mul, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @div a b _ _ _ iha ihb =>
    intro F hRF σ hσ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hσa⟩ := iha F hRF σ hσ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hσb⟩ :=
      ihb F1 (hRF.trans h1) σ1 (real_ext h1 σ σ1 e1 hσ hRF)
    refine ⟨F2, h1.trans h2, F2.div_mem (h2 ha1) hb2, σ2, fun y => ?_, ra / rb, ?_⟩
    · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
    · have : (⟨a / b, F2.div_mem (h2 ha1) hb2⟩ : F2) = ⟨a, h2 ha1⟩ / ⟨b, hb2⟩ := rfl
      rw [this, map_div₀, hσb, e2 ⟨a, ha1⟩, hσa]; push_cast; ring
  | @sqrt a b z _ _ hz hzz iha ihb =>
    intro F hRF σ hσ
    obtain ⟨F1, h1, ha1, σ1, e1, ra, hσa⟩ := iha F hRF σ hσ
    obtain ⟨F2, h2, hb2, σ2, e2, rb, hσb⟩ :=
      ihb F1 (hRF.trans h1) σ1 (real_ext h1 σ σ1 e1 hσ hRF)
    have hσa2 : σ2 ⟨a, h2 ha1⟩ = (ra : ℂ) := by rw [e2 ⟨a, ha1⟩, hσa]
    have hz2F : z ^ 2 ∈ F2 := by
      rw [hzz]; exact F2.add_mem (F2.pow_mem (h2 ha1) 2) (F2.pow_mem hb2 2)
    have hσz2 : σ2 ⟨z ^ 2, hz2F⟩ = ((ra ^ 2 + rb ^ 2 : ℝ) : ℂ) := by
      have : (⟨z ^ 2, hz2F⟩ : F2) = ⟨a, h2 ha1⟩ ^ 2 + ⟨b, hb2⟩ ^ 2 :=
        Subtype.ext (by simp [hzz])
      rw [this, map_add, map_pow, map_pow, hσa2, hσb]; push_cast; ring
    have hpos : (0 : ℝ) ≤ ra ^ 2 + rb ^ 2 := by positivity
    by_cases hzF : z ∈ F2
    · refine ⟨F2, h1.trans h2, hzF, σ2, fun y => ?_, ?_⟩
      · rw [← e1 y]; exact e2 ⟨y, h1 y.2⟩
      · have hsq : σ2 ⟨z, hzF⟩ ^ 2 = ((ra ^ 2 + rb ^ 2 : ℝ) : ℂ) := by
          rw [← hσz2, ← map_pow]; rfl
        rcases real_of_sq_eq hpos hsq with h | h
        · exact ⟨_, h⟩
        · exact ⟨-Real.sqrt (ra ^ 2 + rb ^ 2), by rw [h]; push_cast; ring⟩
    · have hE := quadExt_closure hz2F
      obtain ⟨σ3, e3, hσ3⟩ := exists_ext hE hzF σ2 (Real.sqrt (ra ^ 2 + rb ^ 2) : ℂ) (by
        rw [hσz2, ← Complex.ofReal_pow, Real.sq_sqrt hpos])
      refine ⟨_, (h1.trans h2).trans hE.le, hE.mem, σ3, fun y => ?_, _, hσ3⟩
      rw [← e1 y, ← e2 ⟨y, h1 y.2⟩]; exact e3 ⟨y, h2 (h1 y.2)⟩

/-- **The condition of Theorem 44 is necessary**, for every domain `R`: if the numbers of a tower
of square roots over `R` lie in `Ω(R)`, every radicand is a nonnegative real number under every
embedding real on `R`. -/
theorem theorem44_necessary (R : Subfield ℝ) :
    ∀ l : List ℝ, ValidTowerOver R l →
      (∀ x ∈ towerFieldOver R l, PythClosure (R : Set ℝ) x) → RealTowerOver R l
  | [], _, _ => trivial
  | a :: l, ⟨hv, ha, ha0⟩, hle => by
    have hsub : towerFieldOver R l ≤ towerFieldOver R (a :: l) :=
      fun _ hx => Subfield.subset_closure (Or.inl hx)
    refine ⟨theorem44_necessary R l hv (fun x hx => hle x (hsub hx)), ha, fun σ hσ => ?_⟩
    have hb : Real.sqrt a ∈ towerFieldOver R (a :: l) := Subfield.subset_closure (Or.inr rfl)
    obtain ⟨F', h1, hbF', σ', e, r, hσ'⟩ :=
      pyth_ext (hle _ hb) (towerFieldOver R l) (le_towerFieldOver R l) σ hσ
    refine ⟨r ^ 2, sq_nonneg r, ?_⟩
    rw [← e ⟨a, ha⟩]
    rw [show (⟨((⟨a, ha⟩ : towerFieldOver R l) : ℝ), h1 ha⟩ : F') = ⟨Real.sqrt a, hbF'⟩ ^ 2 from
      Subtype.ext (by simp [Real.sq_sqrt ha0]), map_pow, hσ']
    push_cast; ring

end HilbertFoundations
